#!/usr/bin/env bash
#
# tests/run — the single entry point for this repository's test suite.
#
#   tests/run              Fast gate: every fast-tier unit.
#   tests/run --full       Full gate: both tiers, then the FULL GATE: verdict line.
#   tests/run --jobs N     use N workers (default: the machine's CPU count)
#
# Discovery covers three groups:
#
#   tests/*-test.sh        shell tests
#   general/bin/*.test     bash tests
#   pi/tests               the Bun suite, run as one unit (`bun test pi/tests`)
#
# Tier classification lives in the test file, not in this runner: the runner
# keeps no list of slow file names. A test is slow-tier when it carries the
# marker line
#
#   # tier: slow
#
# as a comment line in the file's header, conventionally on the line next to
# the shebang. The header is the leading run of blank and comment (`#`) lines,
# allowing an optional `#!` shebang as the first line; it ends at the first line
# that is neither blank nor a comment. A `# tier:` line anywhere after the
# header is not a marker and is ignored, so a stray marker in the body of a test
# never silently reclassifies it. Within the header, a comment whose keyword
# contains `tier` (case-insensitively) but is not exactly `tier` — a typo such as
# `# tiers: slow` — is a malformed marker, not prose. The `tier` keyword is
# matched case-insensitively, so `# Tier: slow` is the marker it looks like; the
# value must be exactly `slow` or `fast`. The accepted values are:
#
#   # tier: slow   slow tier: excluded from the Fast gate, included by --full
#   # tier: fast   fast tier: an explicit statement of the default below
#   (no marker)    fast tier
#
# Any other value (`# tier: sloww`), a marker with no value (`# tier:`), two
# conflicting tier markers in one file, or a header comment whose keyword merely
# contains `tier` (`# tiers: slow`) is a RUNNER ERROR: the runner prints a
# message naming the file, the line and the offending keyword or value, and
# exits 2. A malformed marker is never silently treated as fast.
#
# `--full` runs the union of both tiers: the slow files are appended to the
# fast file list discovered in the same pass, so the Full gate's file set is a
# strict superset of the Fast gate's by construction.
#
# The repository root is resolved from this script's own location, so the
# runner works from any current directory. Every unit is executed from the
# repository root.
#
# Units run concurrently. The worker count defaults to the machine's available
# CPUs (`nproc`, falling back to `getconf _NPROCESSORS_ONLN`, then to 1) and is
# overridable with `--jobs N`. A non-positive or non-integer `--jobs` value is a
# RUNNER ERROR. The Bun suite is a single unit and is never split, so `pi/tests`
# costs one worker however many CPUs exist. Units are already isolated by
# construction (each uses its own `mktemp -d`, fixture HOME and stubbed
# binaries); the runner introduces no shared mutable state between them, there
# is no serialisation around a unit that cannot run beside its peers, and every
# unit's captured output goes to its own index-named file. A unit's verdict is
# printed the moment it finishes, in finish order, so the run does not buffer
# everything to the end.
#
# Output: each unit reports its tier, name and duration as it finishes; a
# failing unit also prints its captured output. The run ends with a summary and
# the total wall clock. A `--full` run prints one final line, after the wall
# clock and nothing else, exactly
#
#   FULL GATE: PASS
#   FULL GATE: FAIL
#
# so the verdict is always the last line of a Full gate run. There is no
# fail-fast: one run reports every failure.
#
# Duration budgets: the runner declares a per-unit ceiling for each tier and a
# total for the gate it is running, prints them in the summary, and marks a unit
# that exceeds its ceiling with `OVER BUDGET`. A breach is reported and never
# changes the exit status: a red suite must mean a broken assertion, not a slow
# machine. The budgets are stated in .scratch/quality-gateway/spec.md and the
# reasoning is in docs/adr/0006-duration-is-reported-not-enforced.md.
#
# Exit status:
#   0   every unit passed
#   1   at least one unit failed (a red suite)
#   2   the runner itself failed (bad usage including a bad `--jobs`, bad tier
#       marker, missing tool, ...)
#
# A broken environment is not a red suite: a runner error prints the
# distinguishable `tests/run: RUNNER ERROR:` message and exits 2, and it never
# prints `FULL GATE: PASS`.
#
# Every unit runs with stdin closed and a hard per-unit timeout: several tests
# in this repository block forever when stdin is left open. The runner never
# sets or touches TMPDIR/TMP/TEMP for its children, because the Bun tests
# create their scratch directories with mkdtempSync(tmpdir(), ...).

set -uo pipefail

# Hard per-unit timeout, in seconds. This is the bound that turns a hang into a
# failure; it is not a budget, and a unit that reaches it has failed.
UNIT_TIMEOUT=300

# Declared duration budgets, in seconds: a per-unit ceiling for each tier and a
# total for the gate being run. They are ceilings on what the suite costs, not
# correctness bounds, so a breach is reported and never fatal — see the note on
# duration budgets in this file's header. The two tiers differ by two orders of
# magnitude by construction, which is why the ceilings are per tier.
FAST_UNIT_BUDGET=5
SLOW_UNIT_BUDGET=60
FAST_TOTAL_BUDGET=5
FULL_TOTAL_BUDGET=75

# ---------------------------------------------------------------------------
# Environment and repository location
# ---------------------------------------------------------------------------

runner_error() {
	printf 'tests/run: RUNNER ERROR: %s\n' "$1" >&2
	exit 2
}

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd) ||
	runner_error 'cannot resolve this script'"'"'s directory'

ROOT_DIR=$(cd -- "$SCRIPT_DIR/.." && pwd) ||
	runner_error "cannot resolve the repository root from $SCRIPT_DIR"

cd -- "$ROOT_DIR" || runner_error "cannot enter $ROOT_DIR"

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------

MODE=fast
JOBS=''
JOBS_GIVEN=0
while (( $# > 0 )); do
	case $1 in
	--full)
		MODE=full
		shift
		;;
	--jobs)
		shift
		(( $# > 0 )) || runner_error "'--jobs' requires a value (usage: tests/run [--full] [--jobs N])"
		JOBS=$1
		JOBS_GIVEN=1
		shift
		;;
	--jobs=*)
		JOBS=${1#--jobs=}
		JOBS_GIVEN=1
		shift
		;;
	*)
		runner_error "unknown argument '$1' (usage: tests/run [--full] [--jobs N])"
		;;
	esac
done

# Portable "available CPUs": `nproc` first, then `getconf`, then a single
# worker. Nothing fancy is required; the point is a sane default with no extra
# dependency.
detect_cpus() {
	local n=''
	if command -v nproc >/dev/null 2>&1; then
		n=$(nproc 2>/dev/null || true)
		if [[ $n =~ ^[0-9]+$ ]] && (( n > 0 )); then
			printf '%s' "$n"
			return
		fi
	fi
	if command -v getconf >/dev/null 2>&1; then
		n=$(getconf _NPROCESSORS_ONLN 2>/dev/null || true)
		if [[ $n =~ ^[0-9]+$ ]] && (( n > 0 )); then
			printf '%s' "$n"
			return
		fi
	fi
	printf '1'
}

if (( JOBS_GIVEN )); then
	# A caller-supplied worker count must be a positive integer: `0`, a negative
	# number, an empty value or a word is a runner error, not a silent default.
	if ! [[ $JOBS =~ ^[0-9]+$ ]] || ! (( JOBS > 0 )); then
		runner_error "'--jobs $JOBS' is not a positive integer (usage: tests/run [--full] [--jobs N])"
	fi
else
	JOBS=$(detect_cpus)
fi

# ---------------------------------------------------------------------------
# Clock
# ---------------------------------------------------------------------------

# Seconds since the epoch as a decimal number. EPOCHREALTIME (bash >= 5) is
# read without forking; `date` is the fallback for older shells.
NOW=""
set_now() {
	if [[ -n ${EPOCHREALTIME:-} ]]; then
		NOW=$EPOCHREALTIME
		return
	fi
	local t
	t=$(date +%s.%N 2>/dev/null) || t=""
	if [[ -n $t && $t != *N ]]; then
		NOW=$t
	else
		NOW=$(date +%s)
	fi
}

format_duration() { # <start-seconds> <end-seconds> -> "0.42"
	awk -v a="$1" -v b="$2" 'BEGIN { printf "%.2f", b - a }'
}

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------

# Every unit is bounded by `timeout`. Falling back to an unbounded run would
# reintroduce the hang this runner exists to prevent, so a missing `timeout` is
# a hard error rather than a degraded run.
TIMEOUT_BIN=""
for candidate in timeout gtimeout; do
	if command -v "$candidate" >/dev/null 2>&1; then
		TIMEOUT_BIN=$candidate
		break
	fi
done
[[ -n $TIMEOUT_BIN ]] ||
	runner_error "the 'timeout' command is required to bound every test and was not found on PATH"

BUN_BIN=""
if command -v bun >/dev/null 2>&1; then
	BUN_BIN=bun
fi

# The real-Pi suite (tier: slow) runs only in the full gate and needs the
# installed pi; a missing pi is a broken environment, not a failing test.
if [[ $MODE == full ]]; then
	command -v pi >/dev/null 2>&1 ||
		runner_error "the 'pi' tool is required by the full gate's real-Pi suite and was not found on PATH"
fi

# ---------------------------------------------------------------------------
# Discovery
# ---------------------------------------------------------------------------

shopt -s nullglob
SHELL_TESTS=(tests/*-test.sh)
BIN_TESTS=(general/bin/*.test)

(( ${#SHELL_TESTS[@]} > 0 )) || runner_error 'no shell tests matched tests/*-test.sh'
(( ${#BIN_TESTS[@]} > 0 )) || runner_error 'no bash tests matched general/bin/*.test'
[[ -d pi/tests ]] || runner_error 'the Bun suite directory pi/tests is missing'
[[ -n $BUN_BIN ]] ||
	runner_error "the 'bun' tool is required to run the pi/tests group and was not found on PATH"

for f in "${SHELL_TESTS[@]}" "${BIN_TESTS[@]}"; do
	[[ -r $f ]] || runner_error "test file is not readable: $f"
done

# ---------------------------------------------------------------------------
# Tier classification
# ---------------------------------------------------------------------------

# The marker is a comment line `# tier: VALUE` in the file's header. The header
# is the leading run of blank and comment (`#`) lines, with an optional `#!`
# shebang as the first line; scanning stops at the first line that is neither
# blank nor a comment, so a marker after the header is ignored rather than
# honoured. FILE_TIER is set by tier_of rather than printed, so that a malformed
# marker can abort the whole run (a runner_error inside a command substitution
# would only exit the subshell and silently degrade to the fast tier).
FILE_TIER=fast
tier_of() { # <file> -> sets FILE_TIER; a malformed marker is a runner error
	local file=$1
	local line='' lineno=0 text='' key='' value='' tier=''
	while IFS= read -r line || [[ -n $line ]]; do
		lineno=$(( lineno + 1 ))
		# A blank line keeps the header open; an indented comment is still a
		# comment line, and a shebang (`#!`) is a comment by construction.
		text=${line#"${line%%[![:space:]]*}"}
		case $text in
		'') continue ;;
		'#'*) ;;
		*) break ;;
		esac
		text=${text#'#'}
		# Only a comment carrying a key (the text before its first colon) can be
		# a tier marker; every other header comment is prose.
		[[ $text == *:* ]] || continue
		key=${text%%:*}
		key=${key#"${key%%[![:space:]]*}"}
		key=${key%"${key##*[![:space:]]}"}
		value=${text#*:}
		value=${value#"${value%%[![:space:]]*}"}
		value=${value%"${value##*[![:space:]]}"}
		if [[ ${key,,} != tier ]]; then
			# A keyword that merely contains `tier` is a malformed marker, not
			# prose: `# tiers: slow` must never be silently ignored.
			if [[ ${key,,} == *tier* ]]; then
				runner_error "$file:$lineno: malformed tier marker keyword '$key' in '$line'; the keyword must be exactly 'tier' (use '# tier: slow' or '# tier: fast')"
			fi
			continue
		fi
		case $value in
		slow | fast) ;;
		'') runner_error "$file:$lineno: tier marker has no value ('# tier:'); use '# tier: slow' or '# tier: fast'" ;;
		*) runner_error "$file:$lineno: unrecognised tier marker value '$value'; use '# tier: slow' or '# tier: fast' (or no marker for the fast tier)" ;;
		esac
		if [[ -n $tier && $tier != "$value" ]]; then
			runner_error "$file:$lineno: conflicting tier markers ('$tier' and '$value')"
		fi
		tier=$value
	done <"$file"
	FILE_TIER=${tier:-fast}
}

FAST_FILES=()
SLOW_FILES=()
for f in "${SHELL_TESTS[@]}" "${BIN_TESTS[@]}"; do
	tier_of "$f"
	if [[ $FILE_TIER == slow ]]; then
		SLOW_FILES+=("$f")
	else
		FAST_FILES+=("$f")
	fi
done

# Every discovered file belongs to exactly one tier, so `--full` runs the fast
# set plus the slow set: a strict superset of the bare invocation's file set.
(( ${#FAST_FILES[@]} + ${#SLOW_FILES[@]} == ${#SHELL_TESTS[@]} + ${#BIN_TESTS[@]} )) ||
	runner_error 'internal error: the tier partition lost a discovered test file'

if [[ $MODE == full ]]; then
	FILES=("${FAST_FILES[@]}" "${SLOW_FILES[@]}")
else
	FILES=("${FAST_FILES[@]}")
fi

TOTAL_UNITS=$(( ${#FILES[@]} + 1 ))

# ---------------------------------------------------------------------------
# Execution
# ---------------------------------------------------------------------------

TMP_DIR=$(mktemp -d) || runner_error 'cannot create a temporary directory'

# Completion channel: a worker writes its unit index to this FIFO the moment it
# is done, so the parent reports a unit as it finishes (in finish order) instead
# of buffering every unit's output to the end of the run. The parent holds the
# FIFO open read-write so `read` never sees a spurious EOF between workers.
COMPLETION_FIFO="$TMP_DIR/completion"
mkfifo -- "$COMPLETION_FIFO" || runner_error 'cannot create the completion FIFO'

# Invoked indirectly by the EXIT trap below, so shellcheck cannot see a call.
# shellcheck disable=SC2329
cleanup() {
	local pid
	for pid in $(jobs -p 2>/dev/null); do
		kill "$pid" 2>/dev/null || true
	done
	rm -rf -- "$TMP_DIR"
}
trap cleanup EXIT

RESULTS_DIR="$TMP_DIR/results"
mkdir -- "$RESULTS_DIR" || runner_error 'cannot create the results directory'

# Units that finished over their tier's ceiling, as "<label> <duration>s". Kept
# for the summary so that a breach is visible in one place at the end of the run.
OVER_BUDGET_UNITS=()

# run_unit_worker <index> <tier> <label> <command...>
# Background worker for one unit: runs it with stdin closed and a hard timeout,
# then records its tier, duration, exit status and captured output under its own
# index-named files — unique even when many workers run at once — and finally
# announces completion on the FIFO. It prints nothing itself; the parent owns
# all output, so verdicts never interleave.
run_unit_worker() {
	local index=$1 tier=$2 label=$3
	shift 3

	local outfile="$TMP_DIR/unit.$index.out"
	local start='' end='' rc=0 status=PASS duration=''

	set_now
	start=$NOW
	"$TIMEOUT_BIN" "$UNIT_TIMEOUT" "$@" >"$outfile" 2>&1 </dev/null || rc=$?
	set_now
	end=$NOW
	duration=$(format_duration "$start" "$end")
	(( rc == 0 )) || status=FAIL

	printf '%s\t%s\t%s\t%s\t%s\n' "$status" "$tier" "$duration" "$rc" "$label" >"$TMP_DIR/unit.$index.meta"
	printf '%s\n' "$index" >"$COMPLETION_FIFO"
}

# over_budget <seconds> <ceiling> is true when the duration exceeds the ceiling.
over_budget() {
	awk -v d="$1" -v c="$2" 'BEGIN { exit !(d > c) }'
}

# report_unit <index>
# Prints a finished unit's verdict: a passing unit reports only its duration; a
# failing unit also shows its captured output. The verdict is recorded for the
# summary, filed by unit index so the summary is independent of finish order.
report_unit() {
	local index=$1
	local status='' tier='' duration='' rc='' label=''
	IFS=$'\t' read -r status tier duration rc label <"$TMP_DIR/unit.$index.meta"

	local ceiling='' over=''
	if [[ $tier == slow ]]; then
		ceiling=$SLOW_UNIT_BUDGET
	else
		ceiling=$FAST_UNIT_BUDGET
	fi
	if over_budget "$duration" "$ceiling"; then
		over=" OVER BUDGET (${tier} unit ceiling ${ceiling}s)"
		OVER_BUDGET_UNITS+=("$label ${duration}s")
	fi

	if [[ $status == PASS ]]; then
		printf 'PASS %s [%s] (%ss)%s\n' "$label" "$tier" "$duration" "$over"
	else
		printf 'FAIL %s [%s] (%ss, exit %s)%s\n' "$label" "$tier" "$duration" "$rc" "$over"
		printf '%s\n' '----- output -----'
		cat -- "$TMP_DIR/unit.$index.out"
		# Keep the end marker on its own line even when the captured output does
		# not end with a newline (`tail -c 1` yields the final byte; command
		# substitution strips it when it is a newline).
		if [[ -s $TMP_DIR/unit.$index.out && -n $(tail -c 1 -- "$TMP_DIR/unit.$index.out") ]]; then
			printf '\n'
		fi
		printf '%s\n' '--- end output ---'
		printf '\n'
	fi

	printf '%s\t%s\t%s\t%s\n' "$status" "$tier" "$duration" "$label" >"$RESULTS_DIR/result.$index"
}

# The unit list is the launch order. A Full gate dispatches the slow-tier files
# first: they are the longest individual units, so starting them first is the
# longest-processing-time-first schedule that keeps the critical path (the
# slowest file) off the end of the run. The fast files follow, then the Bun
# suite as one unit. TOTAL_UNITS includes the Bun unit, so the list length
# proves no unit was lost.
UNIT_TIERS=()
UNIT_LABELS=()
UNIT_FILES=()
if [[ $MODE == full ]]; then
	for f in "${SLOW_FILES[@]}"; do
		UNIT_TIERS+=("slow")
		UNIT_LABELS+=("$f")
		UNIT_FILES+=("$f")
	done
fi
for f in "${FAST_FILES[@]}"; do
	UNIT_TIERS+=("fast")
	UNIT_LABELS+=("$f")
	UNIT_FILES+=("$f")
done
UNIT_TIERS+=("fast")
UNIT_LABELS+=('pi/tests (bun test)')
UNIT_FILES+=('')

(( ${#UNIT_LABELS[@]} == TOTAL_UNITS )) ||
	runner_error 'internal error: the unit list does not match the discovered test count'

# start_unit <index>; the Bun unit (empty file) is a single `bun test` process.
start_unit() {
	local i=$1
	if [[ -z ${UNIT_FILES[$i]} ]]; then
		run_unit_worker "$i" "${UNIT_TIERS[$i]}" "${UNIT_LABELS[$i]}" "$BUN_BIN" test pi/tests &
	else
		run_unit_worker "$i" "${UNIT_TIERS[$i]}" "${UNIT_LABELS[$i]}" bash "${UNIT_FILES[$i]}" &
	fi
}

if [[ $MODE == full ]]; then
	printf 'tests/run: running %d units from %s with %d worker(s) (fast tier: %d files, slow tier: %d files)\n\n' \
		"$TOTAL_UNITS" "$ROOT_DIR" "$JOBS" "${#FAST_FILES[@]}" "${#SLOW_FILES[@]}"
else
	printf 'tests/run: running %d units from %s with %d worker(s) (fast tier only)\n\n' \
		"$TOTAL_UNITS" "$ROOT_DIR" "$JOBS"
fi

set_now
TOTAL_START=$NOW

# Bounded worker pool: at most $JOBS units run at once. Each completion is read
# from the FIFO and reported immediately, so output follows real time rather
# than discovery order. There is no fail-fast: a red unit never stops the pool.
exec 3<>"$COMPLETION_FIFO"

running=0
next=0
while (( next < TOTAL_UNITS )); do
	if (( running >= JOBS )); then
		IFS= read -r finished <&3
		report_unit "$finished"
		running=$(( running - 1 ))
	fi
	start_unit "$next"
	next=$(( next + 1 ))
	running=$(( running + 1 ))
done

while (( running > 0 )); do
	IFS= read -r finished <&3
	report_unit "$finished"
	running=$(( running - 1 ))
done

exec 3>&-
wait

set_now
TOTAL_END=$NOW

# ---------------------------------------------------------------------------
# Report
# ---------------------------------------------------------------------------

passed=0
failed=0
failed_labels=()
recorded=0
for (( i = 0; i < TOTAL_UNITS; i++ )); do
	[[ -r $RESULTS_DIR/result.$i ]] || runner_error "internal error: unit $i finished without a recorded result"
	IFS=$'\t' read -r status tier duration label <"$RESULTS_DIR/result.$i"
	recorded=$((recorded + 1))
	if [[ $status == PASS ]]; then
		passed=$((passed + 1))
	else
		failed=$((failed + 1))
		failed_labels+=("$label")
	fi
done

(( recorded == TOTAL_UNITS )) ||
	runner_error "recorded $recorded units but discovered $TOTAL_UNITS"

total=$(format_duration "$TOTAL_START" "$TOTAL_END")

if [[ $MODE == full ]]; then
	budget_scope='Full gate'
	budget_total=$FULL_TOTAL_BUDGET
else
	budget_scope='Fast gate'
	budget_total=$FAST_TOTAL_BUDGET
fi

printf '\n'
if (( failed == 0 )); then
	printf 'ALL PASSED: %d of %d units\n' "$passed" "$TOTAL_UNITS"
else
	printf 'FAILED: %d of %d units:\n' "$failed" "$TOTAL_UNITS"
	for label in "${failed_labels[@]}"; do
		printf '  - %s\n' "$label"
	done
fi

# The budget report is always printed, green or red: the number nobody looked at
# is what let the Full gate grow from 12s to 115s without a single failure.
budget_breaches=()
if (( ${#OVER_BUDGET_UNITS[@]} > 0 )); then
	budget_breaches=("${OVER_BUDGET_UNITS[@]}")
fi
if over_budget "$total" "$budget_total"; then
	budget_breaches+=("$budget_scope ${total}s")
fi
printf 'duration budget (fast unit <=%ss, slow unit <=%ss, %s <=%ss): ' \
	"$FAST_UNIT_BUDGET" "$SLOW_UNIT_BUDGET" "$budget_scope" "$budget_total"
if (( ${#budget_breaches[@]} == 0 )); then
	printf 'WITHIN\n'
else
	printf 'OVER — %s\n' "${budget_breaches[*]}"
fi

printf 'total wall clock: %ss\n' "$total"

# The verdict is the last line of a Full gate run, printed after the wall
# clock so that nothing follows it. A bare (Fast gate) run prints no verdict:
# a green Fast gate is not the completion signal.
exit_status=0
if (( failed > 0 )); then
	exit_status=1
fi
if [[ $MODE == full ]]; then
	if (( exit_status == 0 )); then
		printf 'FULL GATE: PASS\n'
	else
		printf 'FULL GATE: FAIL\n'
	fi
fi

exit "$exit_status"
