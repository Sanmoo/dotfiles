#!python

"""
Usage:
 - Save this script somewhere on your path (e.g. `vi /usr/local/bin/aws-console && chmod +x /usr/local/bin/aws-console`)
 - Make AWS credentials available in one of the usual places where boto3 can find them (~/.aws/credentials, env var, etc.)
 - Excute the script: `aws-console --profile myprofile`
 - :tada: Your browser opens and you are signed in into the AWS console

Non-default profiles open in a dedicated browser profile (aws-<sanitized name>)
so each AWS account keeps its own console session. The browser is resolved per
OS (google-chrome-stable on Linux, the Microsoft Edge app-bundle binary on
macOS) and can be overridden with AWS_CONSOLE_BROWSER (a name on PATH or a full
path). A missing or non-Chromium binary warns on stderr and falls back to the
platform's default browser.
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import webbrowser
from urllib import parse, request

import boto3

DEFAULT_FEDERATION_ENDPOINT = "https://signin.aws.amazon.com/federation"
FEDERATION_ENDPOINT_ENV = "AWS_CONSOLE_FEDERATION_ENDPOINT"
BROWSER_ENV = "AWS_CONSOLE_BROWSER"
PER_OS_BROWSERS = {
    "linux": "google-chrome-stable",
    "darwin": "/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge",
}


def federation_endpoint():
    return os.environ.get(FEDERATION_ENDPOINT_ENV, DEFAULT_FEDERATION_ENDPOINT)


def build_destination(account):
    return f"https://console.aws.amazon.com/?account={account}"


def sanitize_binding(profile_name):
    return re.sub(r"[^A-Za-z0-9._-]", "-", profile_name)


def build_binding(profile_name):
    return "aws-" + sanitize_binding(profile_name)


def resolve_browser(platform_name, override=None):
    if override:
        return override
    return PER_OS_BROWSERS.get(platform_name)


def looks_chromium(browser):
    base = os.path.basename(browser).lower()
    return "chrom" in base or "edge" in base


def should_isolate(profile_name):
    return profile_name is not None and profile_name != "default"


def build_get_signin_token_url(endpoint, credentials):
    request_parameters = "?Action=getSigninToken"
    request_parameters += "&DurationSeconds=43200"
    request_parameters += "&Session=" + parse.quote_plus(json.dumps(credentials))
    return endpoint + request_parameters


def fetch_signin_token(token_url):
    with request.urlopen(token_url) as response:
        if not response.status == 200:
            raise Exception("Failed to get federation token")
        signin_token = json.loads(response.read())
    return signin_token["SigninToken"]


def build_login_url(endpoint, destination, signin_token):
    request_parameters = "?Action=login"
    request_parameters += "&Destination=" + parse.quote_plus(destination)
    request_parameters += "&SigninToken=" + signin_token
    request_parameters += "&Issuer=" + parse.quote_plus("https://example.com")
    return endpoint + request_parameters


def announce_binding(binding):
    print(f"aws-console: using browser profile {binding}", file=sys.stderr)


def warn_fallback(browser):
    if browser is None:
        reason = "no browser configured for this platform"
    else:
        reason = (
            f"{browser} is not available or does not look like a "
            "Chromium-family browser"
        )
    print(
        f"aws-console: warning: {reason}; falling back to the default browser",
        file=sys.stderr,
    )


def open_in_profile(browser, binding, login_url):
    subprocess.Popen(
        [browser, f"--profile-directory={binding}", login_url],
        start_new_session=True,
    )


def open_console(profile_name=None, echo_to_stdout=False):
    session = boto3.Session(profile_name=profile_name)
    creds = session.get_credentials()
    if not creds:
        raise Exception("Cannot locate AWS credentials")
    sts = session.client("sts")
    account = sts.get_caller_identity()["Account"]

    url_credentials = dict(
        sessionId=creds.access_key,
        sessionKey=creds.secret_key,
        sessionToken=creds.token,
    )
    endpoint = federation_endpoint()
    signin_token = fetch_signin_token(
        build_get_signin_token_url(endpoint, url_credentials)
    )
    destination = build_destination(account)
    login_url = build_login_url(endpoint, destination, signin_token)
    isolated = should_isolate(profile_name)

    if echo_to_stdout:
        print(login_url)
        if isolated:
            announce_binding(build_binding(profile_name))
        return

    if isolated:
        browser = resolve_browser(sys.platform, os.environ.get(BROWSER_ENV))
        if (
            browser is None
            or shutil.which(browser) is None
            or not looks_chromium(browser)
        ):
            warn_fallback(browser)
            webbrowser.open(login_url)
        else:
            binding = build_binding(profile_name)
            announce_binding(binding)
            open_in_profile(browser, binding, login_url)
        return

    webbrowser.open(login_url)


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Open the AWS console in your web browser, using your AWS CLI credentials"
    )
    parser.add_argument(
        "--profile",
        default=None,
        help=(
            "the AWS profile to create the presigned URL with; non-default "
            "profiles open in a dedicated browser profile (aws-<name>)"
        ),
    )
    parser.add_argument(
        "--stdout",
        action="store_true",
        help="don't open the webbrowser, but echo the signin URL to stdout",
    )

    args = parser.parse_args()
    open_console(args.profile, args.stdout)
