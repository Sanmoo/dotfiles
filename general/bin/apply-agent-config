#!/usr/bin/env bash
# Apply only repository-owned agent configuration; never install dependencies.
set -euo pipefail

if (($# < 1 || $# > 2)); then
	printf 'Usage: %s CHECKOUT [HOME_DIRECTORY]\n' "${0##*/}" >&2
	exit 2
fi
checkout=$(cd "$1" && pwd -P)
home=$(cd "${2:-$HOME}" && pwd -P)
case "$home/" in
	"$checkout/"*) echo 'Home must be outside the checkout' >&2; exit 1 ;;
esac
for directory in "$home/.agents" "$home/.agents/skills"; do
	if [[ -L "$directory" || ( -e "$directory" && ! -d "$directory" ) ]]; then
		printf 'Refusing unexpected directory state: %s. Migrate the legacy link first.\n' "$directory" >&2
		exit 1
	fi
done

# Publish only content tracked by the checkout. Machine-local skill installs
# are untracked entries under the package, often gitignored absolute symlinks,
# and Stow aborts when it meets one. Ask Git for every untracked path under the
# package and ignore each one, so the tracked index is the single source of
# truth for what the package distributes.
if ! prefix=$(git -C "$checkout" rev-parse --show-prefix 2>/dev/null); then
	printf 'Checkout is not a Git work tree: %s\n' "$checkout" >&2
	exit 1
fi
if [[ -z "$(git -C "$checkout" ls-files -- agents)" ]]; then
	printf 'Checkout tracks no agents package content: %s\n' "$checkout" >&2
	exit 1
fi

ignore_args=()
while IFS= read -r -d '' path; do
	path=${path#"$prefix"}
	path=${path#agents/}
	path=${path%/}
	[[ -n "$path" ]] || continue
	escaped=$(printf '%s' "$path" | sed 's/[][\\.^$*+?(){}|]/\\&/g')
	ignore_args+=(--ignore="^${escaped}$")
done < <(
	git -C "$checkout" ls-files --others --directory -z -- agents
	git -C "$checkout" ls-files --others --ignored --exclude-standard --directory -z -- agents
)

stow --no-folding --simulate --dir="$checkout" --target="$home" "${ignore_args[@]}" agents
stow --no-folding --dir="$checkout" --target="$home" "${ignore_args[@]}" agents
