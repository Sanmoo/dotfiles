#!/usr/bin/env python3
"""Replace a legacy agent-directory link with a verified independent copy."""

import argparse
from collections import deque
import hashlib
import json
import os
from pathlib import Path
import shutil
import signal
import stat
import sys
import tempfile


def inventory(root):
    """Read content and link text without following links, including broken ones."""
    entries = {}

    def visit(path):
        info = path.lstat()
        relative = str(path.relative_to(root))
        mode = stat.S_IMODE(info.st_mode)
        if stat.S_ISLNK(info.st_mode):
            entries[relative] = ("link", mode, os.readlink(path))
        elif stat.S_ISREG(info.st_mode):
            digest = hashlib.sha256()
            with path.open("rb") as stream:
                for chunk in iter(lambda: stream.read(1024 * 1024), b""):
                    digest.update(chunk)
            entries[relative] = ("file", mode, digest.hexdigest())
        elif stat.S_ISDIR(info.st_mode):
            entries[relative] = ("directory", mode, "")
            for child in sorted(path.iterdir()):
                visit(child)
        else:
            raise ValueError(f"Unsupported filesystem entry; nothing migrated: {path}")

    visit(root)
    return entries


def resolve_link_path(path):
    """Resolve intermediate links before '..', retaining an unavailable suffix.

    Only metadata is read. Missing targets remain valid migration inputs, and
    missing/../file is not incorrectly converted into an existing file.
    The final link is left as a link so its relationship with its source remains.
    """
    pending = deque(str(path).split("/"))
    current = Path("/")
    followed = 0
    while pending:
        part = pending.popleft()
        if part in ("", "."):
            continue
        if part == "..":
            current = current.parent
            continue
        candidate = current / part
        try:
            info = candidate.lstat()
        except (FileNotFoundError, NotADirectoryError):
            return os.path.join(str(candidate), *pending)
        if not stat.S_ISLNK(info.st_mode) and not stat.S_ISDIR(info.st_mode) and pending:
            return os.path.join(str(candidate), *pending)
        if stat.S_ISLNK(info.st_mode) and pending:
            followed += 1
            if followed > 40:
                raise ValueError(f"Intermediate symlink loop; legacy link unchanged: {path}")
            target = os.readlink(candidate)
            if os.path.isabs(target):
                current = Path("/")
            pending.extendleft(reversed(target.split("/")))
        else:
            current = candidate
    return str(current)


def relocate_link(text, parent, mappings):
    """Rebase only relocation-sensitive links; do not flatten filesystem paths."""
    original = os.path.join(str(parent), text)
    if os.path.isabs(text) and not any(
            original == str(old) or original.startswith(str(old) + "/") for old, _ in mappings):
        return text  # External absolute links are never dereferenced or changed.
    target = resolve_link_path(original)
    for old, new in mappings:
        if target == str(old) or target.startswith(str(old) + "/"):
            if not os.path.isabs(text) and "/" not in text and text not in (".", ".."):
                return text  # A direct relative entry retains its original text.
            rebased = str(new) + target[len(str(old)):]
            return rebased + "/" if text.endswith("/") and not rebased.endswith("/") else rebased
    return target


def migrate(checkout, agents, backup_path=None, extra_skills=()):
    checkout_absolute = Path(os.path.abspath(checkout))
    checkout = checkout.resolve(strict=True)
    source = checkout / "agents" / ".agents"
    # Resolve the parent, not the legacy link itself.
    agents = agents.parent.resolve(strict=True) / agents.name
    if agents == checkout or checkout in agents.parents:
        raise ValueError("Agent directory must be outside the checkout")
    if not agents.is_symlink():
        skills = agents / "skills"
        if agents.is_dir() and not skills.is_symlink() and (not skills.exists() or skills.is_dir()):
            print(f"Already independent: {agents}; no additional sources imported")
            return
        raise ValueError(f"Unexpected agent-directory state: {agents}")
    original_link = os.readlink(agents)
    if source.is_symlink() or not source.is_dir() or agents.resolve() != source:
        raise ValueError(f"Unexpected symlink; expected the legacy directory in {checkout}")
    skills = source / "skills"
    if skills.is_symlink() or (skills.exists() and not skills.is_dir()):
        raise ValueError("The legacy skills directory itself must be real")

    # Each tree has its original root, destination prefix, and recovery snapshot.
    trees = [(source, Path("."), "snapshot", inventory(source))]
    mappings = [(source, agents), (checkout_absolute / "agents" / ".agents", agents)]
    occupied = {p.name for p in skills.iterdir()} if skills.exists() else set()
    for index, root in enumerate(extra_skills):
        absolute = Path(os.path.abspath(root))
        if root.is_symlink() or not root.is_dir():
            raise ValueError(f"Additional skill source must be a real directory: {root}")
        root = root.resolve(strict=True)
        names = {p.name for p in root.iterdir()}
        conflicts = occupied & names
        if conflicts:
            raise ValueError(f"Additional skill names conflict; nothing overwritten: {', '.join(sorted(conflicts))}")
        occupied.update(names)
        trees.append((root, Path("skills"), f"extra-skills-{index}", inventory(root)))
        mappings.extend(((root, agents / "skills"), (absolute, agents / "skills")))
    # A narrower mapping must win if a supplied source is nested in another one.
    mappings.sort(key=lambda pair: len(str(pair[0])), reverse=True)
    backup_parent = agents.parent if backup_path is None else backup_path.parent.resolve(strict=True)
    backup_candidate = backup_parent if backup_path is None else backup_parent / backup_path.name
    if any(backup_candidate == root or root in backup_candidate.parents for root in (checkout, agents, *(t[0] for t in trees))):
        raise ValueError("Backup must be outside the checkout, agent directory, and all sources")
    if backup_path is None:
        backup = Path(tempfile.mkdtemp(prefix=".agents-backup-", dir=backup_parent))
    else:
        backup = backup_candidate
        backup.mkdir(mode=0o700)  # An existing path is a conflict, never a merge.
    print(f"Recovery backup: {backup}", flush=True)
    (backup / "recovery.json").write_text(json.dumps({
        "agent_directory": str(agents), "source": str(source),
        "original_link": original_link, "additional_sources": [str(t[0]) for t in trees[1:]],
    }, indent=2) + "\n")
    staged = backup / "staged"
    expected = dict(trees[0][3])
    for root, prefix, snapshot_name, before in trees:
        snapshot = backup / snapshot_name
        shutil.copytree(root, snapshot, symlinks=True)
        if inventory(snapshot) != before or inventory(root) != before:
            raise ValueError("Source changed or backup verification failed; legacy link is unchanged")
        destination = staged / prefix
        if prefix == Path("."):
            shutil.copytree(snapshot, destination, symlinks=True)
        else:
            destination.mkdir(exist_ok=True)
            mode = stat.S_IMODE(destination.stat().st_mode)
            shutil.copytree(snapshot, destination, dirs_exist_ok=True, symlinks=True)
            destination.chmod(mode)
            expected.setdefault("skills", ("directory", mode, ""))
            expected.update((str(prefix / p), entry) for p, entry in before.items() if p != ".")
    if inventory(staged) != expected:
        raise ValueError("Staging verification failed; legacy link is unchanged")
    # Original link texts remain in the snapshots; active relocation-sensitive
    # links are rebased without copying or modifying any external target.
    for root, prefix, _, before in trees:
        for relative, (kind, mode, text) in before.items():
            if kind != "link":
                continue
            new_text = relocate_link(text, (root / relative).parent, mappings)
            if new_text != text:
                relative_destination = str(prefix / relative)
                link = staged / relative_destination
                link.unlink()
                link.symlink_to(new_text)
                expected[relative_destination] = (kind, mode, new_text)
    if inventory(staged) != expected or any(inventory(root) != before for root, _, _, before in trees):
        raise ValueError("Verification failed; legacy link is unchanged")
    if not agents.is_symlink() or os.readlink(agents) != original_link:
        raise ValueError("Legacy link changed during migration; refusing to replace it")

    saved_link = backup / "legacy-link"
    try:
        agents.rename(saved_link)
        staged.rename(agents)
    except BaseException:
        if saved_link.is_symlink() and not os.path.lexists(agents):
            saved_link.rename(agents)
        raise
    print(f"Migrated: {agents}")


def interrupted(signum, _frame):
    raise InterruptedError(f"Interrupted by signal {signum}")


def main():
    signal.signal(signal.SIGTERM, interrupted)
    signal.signal(signal.SIGHUP, interrupted)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("checkout", type=Path, help="checkout containing the legacy agents/.agents directory")
    parser.add_argument("agents", nargs="?", type=Path, default=Path.home() / ".agents")
    parser.add_argument("--backup", type=Path, help="new recovery directory (must not exist)")
    parser.add_argument("--extra-skills", type=Path, action="append", default=[], help="also preserve skills from a local directory; repeatable")
    args = parser.parse_args()
    try:
        migrate(args.checkout, args.agents, args.backup, args.extra_skills)
    except (OSError, ValueError, KeyboardInterrupt) as error:
        print(f"Migration failed: {error}. Keep the recovery backup and do not remove the legacy files.", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
