#!/usr/bin/env bash
# Tests for general/bin/aws-console. Runs the real script as a subprocess with
# AWS, federation, and the browser stubbed at the process boundary via
# environment: STS through AWS_ENDPOINT_URL_STS against a local HTTP stub,
# federation through AWS_CONSOLE_FEDERATION_ENDPOINT against the same stub,
# the default browser through the BROWSER env var, and the isolated-launch
# browser through AWS_CONSOLE_BROWSER, both pointing at fake scripts that
# record their argv. Zero network, zero real credentials.
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
tmp_dir=$(mktemp -d)
trap 'rm -rf "$tmp_dir"' EXIT

SCRIPT="$script_dir/aws-console"
PORT=$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()')
REQUESTS_LOG="$tmp_dir/requests.log"
BROWSER_CALLS="$tmp_dir/browser.calls"
ENDPOINT="http://127.0.0.1:$PORT"

cat > "$tmp_dir/stub.py" <<'PY'
import json
import sys
from http.server import BaseHTTPRequestHandler, HTTPServer

LOG_FILE = sys.argv[1]
PORT = int(sys.argv[2])

CALLER_IDENTITY_XML = b"""<GetCallerIdentityResponse xmlns="https://sts.amazonaws.com/doc/2011-06-15/">
  <GetCallerIdentityResult>
    <Arn>arn:aws:iam::123456789012:user/test-user</Arn>
    <UserId>AIDACKCEVSQ6C2EXAMPLE</UserId>
    <Account>123456789012</Account>
  </GetCallerIdentityResult>
  <ResponseMetadata>
    <RequestId>01234567-89ab-cdef-0123-456789abcdef</RequestId>
  </ResponseMetadata>
</GetCallerIdentityResponse>
"""

class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def _handle(self):
        length = int(self.headers.get("Content-Length", 0) or 0)
        body = self.rfile.read(length).decode("utf-8", "replace") if length else ""
        with open(LOG_FILE, "a") as f:
            f.write(f"{self.command} {self.path} {body}\n")
            f.write(f"Authorization: {self.headers.get('Authorization', '')}\n")
        query = self.path.split("?", 1)[1] if "?" in self.path else ""
        action = ""
        for part in (query + "&" + body).split("&"):
            if part.startswith("Action="):
                action = part
        if action == "Action=getSigninToken":
            payload = json.dumps({"SigninToken": "FAKESIGNINTOKEN"}).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)
        elif action == "Action=GetCallerIdentity":
            self.send_response(200)
            self.send_header("Content-Type", "text/xml")
            self.send_header("Content-Length", str(len(CALLER_IDENTITY_XML)))
            self.end_headers()
            self.wfile.write(CALLER_IDENTITY_XML)
        else:
            self.send_response(404)
            self.end_headers()

    do_GET = _handle
    do_POST = _handle

HTTPServer(("127.0.0.1", PORT), Handler).serve_forever()
PY

cat > "$tmp_dir/fake-browser" <<'MOCK'
#!/usr/bin/env bash
printf '%s\n' "$@" >> "$BROWSER_CALLS"
MOCK
chmod +x "$tmp_dir/fake-browser"

# fake-chrome stands in for the Chromium-family binary that the script execs
# directly for isolated launches; the name must suggest Chromium or the script
# would refuse to isolate.
cat > "$tmp_dir/fake-chrome" <<'MOCK'
#!/usr/bin/env bash
printf '%s\n' "$@" >> "$BROWSER_CALLS"
MOCK
chmod +x "$tmp_dir/fake-chrome"

python3 "$tmp_dir/stub.py" "$REQUESTS_LOG" "$PORT" &
stub_pid=$!
trap 'rm -rf "$tmp_dir"; kill "$stub_pid" 2>/dev/null || true' EXIT

python3 - "$PORT" <<'PY'
import socket
import sys
import time

port = int(sys.argv[1])
for _ in range(50):
    try:
        s = socket.create_connection(("127.0.0.1", port), timeout=0.2)
        s.close()
        sys.exit(0)
    except OSError:
        time.sleep(0.05)
sys.exit(1)
PY

# The script is executed via python3 because the #!python shebang resolves on
# macOS but not on Linux; the file-level properties are asserted separately.
COMMON_ENV=(
  AWS_ENDPOINT_URL_STS="$ENDPOINT"
  AWS_DEFAULT_REGION=us-east-1
  AWS_EC2_METADATA_DISABLED=true
  AWS_CONSOLE_FEDERATION_ENDPOINT="$ENDPOINT"
  BROWSER="$tmp_dir/fake-browser %s"
  BROWSER_CALLS="$BROWSER_CALLS"
)

# Same as COMMON_ENV but without the region, so that a profile's configured
# region (or the absence of one) is the only region source for deep-link tests.
COMMON_ENV_NO_REGION=()
for kv in "${COMMON_ENV[@]}"; do
  [[ $kv == AWS_DEFAULT_REGION=* ]] || COMMON_ENV_NO_REGION+=("$kv")
done

assert_contains() {
  grep -F -- "$2" "$1" >/dev/null || {
    printf 'missing %s in %s\n' "$2" "$1" >&2
    return 1
  }
}

# --- bare aws-console: default-browser path, env credentials ----------------
: > "$BROWSER_CALLS"
: > "$REQUESTS_LOG"
env "${COMMON_ENV[@]}" \
  AWS_ACCESS_KEY_ID=AKIABARE \
  AWS_SECRET_ACCESS_KEY=bare-secret \
  python3 "$SCRIPT" >"$tmp_dir/bare.out" 2>"$tmp_dir/bare.err"

assert_contains "$REQUESTS_LOG" 'Action=GetCallerIdentity&Version=2011-06-15'
assert_contains "$REQUESTS_LOG" 'Credential=AKIABARE/'
assert_contains "$REQUESTS_LOG" 'Action=getSigninToken&DurationSeconds=43200&Session='
assert_contains "$BROWSER_CALLS" "$ENDPOINT?Action=login&"
assert_contains "$BROWSER_CALLS" 'Destination=https%3A%2F%2Fconsole.aws.amazon.com%2F%3Faccount%3D123456789012'
assert_contains "$BROWSER_CALLS" 'SigninToken=FAKESIGNINTOKEN'
if [[ -s "$tmp_dir/bare.err" ]]; then
  printf 'bare case wrote to stderr\n' >&2
  exit 1
fi

# --- --profile rev-qual: isolated launch in a dedicated browser profile ----
cat > "$tmp_dir/credentials" <<'CRED'
[rev-qual]
aws_access_key_id = AKIAPROFILE
aws_secret_access_key = profile-secret
[default]
aws_access_key_id = AKIADEFAULT
aws_secret_access_key = default-secret
CRED
cat > "$tmp_dir/config" <<'CFG'
[profile rev-qual]
region = sa-east-1
CFG

: > "$BROWSER_CALLS"
: > "$REQUESTS_LOG"
env -u AWS_ACCESS_KEY_ID -u AWS_SECRET_ACCESS_KEY -u AWS_SESSION_TOKEN \
  "${COMMON_ENV[@]}" \
  AWS_CONSOLE_BROWSER="$tmp_dir/fake-chrome" \
  AWS_SHARED_CREDENTIALS_FILE="$tmp_dir/credentials" \
  AWS_CONFIG_FILE="$tmp_dir/config" \
  python3 "$SCRIPT" --profile rev-qual >"$tmp_dir/profile.out" 2>"$tmp_dir/profile.err"

assert_contains "$REQUESTS_LOG" 'Credential=AKIAPROFILE/'
if [[ $(sed -n '1p' "$BROWSER_CALLS") != '--profile-directory=aws-rev-qual' ]]; then
  printf 'profile-directory flag must precede the signin URL\n' >&2
  exit 1
fi
assert_contains "$BROWSER_CALLS" "$ENDPOINT?Action=login&"
assert_contains "$BROWSER_CALLS" 'Destination=https%3A%2F%2Fconsole.aws.amazon.com%2F%3Faccount%3D123456789012'
if [[ -s "$tmp_dir/profile.out" ]]; then
  printf 'isolated case wrote to stdout\n' >&2
  exit 1
fi
assert_contains "$tmp_dir/profile.err" 'aws-rev-qual'

# --- --profile default: default-browser path, no isolation ------------------
: > "$BROWSER_CALLS"
env -u AWS_ACCESS_KEY_ID -u AWS_SECRET_ACCESS_KEY -u AWS_SESSION_TOKEN \
  "${COMMON_ENV[@]}" \
  AWS_CONSOLE_BROWSER="$tmp_dir/fake-chrome" \
  AWS_SHARED_CREDENTIALS_FILE="$tmp_dir/credentials" \
  AWS_CONFIG_FILE="$tmp_dir/config" \
  python3 "$SCRIPT" --profile default >"$tmp_dir/default.out" 2>"$tmp_dir/default.err"

assert_contains "$BROWSER_CALLS" "$ENDPOINT?Action=login&"
if grep -Fq -- '--profile-directory=' "$BROWSER_CALLS"; then
  printf '--profile default must not isolate\n' >&2
  exit 1
fi
if [[ -s "$tmp_dir/default.err" ]]; then
  printf '--profile default wrote to stderr\n' >&2
  exit 1
fi

# --- --stdout prints only the signin URL on stdout --------------------------
: > "$BROWSER_CALLS"
env "${COMMON_ENV[@]}" \
  AWS_ACCESS_KEY_ID=AKIABARE \
  AWS_SECRET_ACCESS_KEY=bare-secret \
  python3 "$SCRIPT" --stdout >"$tmp_dir/stdout.out" 2>"$tmp_dir/stdout.err"

if [[ $(wc -l < "$tmp_dir/stdout.out") -ne 1 ]]; then
  printf '--stdout output must be exactly one line\n' >&2
  exit 1
fi
assert_contains "$tmp_dir/stdout.out" \
  "$ENDPOINT?Action=login&Destination=https%3A%2F%2Fconsole.aws.amazon.com%2F%3Faccount%3D123456789012&SigninToken=FAKESIGNINTOKEN&Issuer="
if [[ -s "$tmp_dir/stdout.err" ]]; then
  printf '--stdout case wrote to stderr\n' >&2
  exit 1
fi
if [[ -s "$BROWSER_CALLS" ]]; then
  printf '--stdout case launched a browser\n' >&2
  exit 1
fi

# --- --stdout with an isolated profile: stdout URL-only, binding on stderr --
: > "$BROWSER_CALLS"
env -u AWS_ACCESS_KEY_ID -u AWS_SECRET_ACCESS_KEY -u AWS_SESSION_TOKEN \
  "${COMMON_ENV[@]}" \
  AWS_CONSOLE_BROWSER="$tmp_dir/fake-chrome" \
  AWS_SHARED_CREDENTIALS_FILE="$tmp_dir/credentials" \
  AWS_CONFIG_FILE="$tmp_dir/config" \
  python3 "$SCRIPT" --profile rev-qual --stdout >"$tmp_dir/iso-stdout.out" 2>"$tmp_dir/iso-stdout.err"

if [[ $(wc -l < "$tmp_dir/iso-stdout.out") -ne 1 ]]; then
  printf '--stdout isolated output must be exactly one line\n' >&2
  exit 1
fi
assert_contains "$tmp_dir/iso-stdout.out" "$ENDPOINT?Action=login&"
assert_contains "$tmp_dir/iso-stdout.err" 'aws-rev-qual'
if [[ -s "$BROWSER_CALLS" ]]; then
  printf '--stdout isolated case launched a browser\n' >&2
  exit 1
fi

# --- missing browser binary: warning + fallback to the default browser ------
: > "$BROWSER_CALLS"
env -u AWS_ACCESS_KEY_ID -u AWS_SECRET_ACCESS_KEY -u AWS_SESSION_TOKEN \
  "${COMMON_ENV[@]}" \
  AWS_CONSOLE_BROWSER=/no/such/browser \
  AWS_SHARED_CREDENTIALS_FILE="$tmp_dir/credentials" \
  AWS_CONFIG_FILE="$tmp_dir/config" \
  python3 "$SCRIPT" --profile rev-qual >"$tmp_dir/missing.out" 2>"$tmp_dir/missing.err"

assert_contains "$tmp_dir/missing.err" 'warning'
assert_contains "$BROWSER_CALLS" "$ENDPOINT?Action=login&"
if grep -Fq -- '--profile-directory=' "$BROWSER_CALLS"; then
  printf 'missing browser must not launch isolated\n' >&2
  exit 1
fi

# --- non-Chromium override: warning + fallback to the default browser -------
: > "$BROWSER_CALLS"
env -u AWS_ACCESS_KEY_ID -u AWS_SECRET_ACCESS_KEY -u AWS_SESSION_TOKEN \
  "${COMMON_ENV[@]}" \
  AWS_CONSOLE_BROWSER="$tmp_dir/fake-browser" \
  AWS_SHARED_CREDENTIALS_FILE="$tmp_dir/credentials" \
  AWS_CONFIG_FILE="$tmp_dir/config" \
  python3 "$SCRIPT" --profile rev-qual >"$tmp_dir/nonchromium.out" 2>"$tmp_dir/nonchromium.err"

assert_contains "$tmp_dir/nonchromium.err" 'warning'
assert_contains "$BROWSER_CALLS" "$ENDPOINT?Action=login&"
if grep -Fq -- '--profile-directory=' "$BROWSER_CALLS"; then
  printf 'non-Chromium browser must not launch isolated\n' >&2
  exit 1
fi

# --- ecs --profile rev-qual: service deep-link in the isolated profile -----
# The env region is dropped so the profile's configured region (sa-east-1)
# is the only region source.
: > "$BROWSER_CALLS"
: > "$REQUESTS_LOG"
env -u AWS_ACCESS_KEY_ID -u AWS_SECRET_ACCESS_KEY -u AWS_SESSION_TOKEN \
  "${COMMON_ENV_NO_REGION[@]}" \
  AWS_CONSOLE_BROWSER="$tmp_dir/fake-chrome" \
  AWS_SHARED_CREDENTIALS_FILE="$tmp_dir/credentials" \
  AWS_CONFIG_FILE="$tmp_dir/config" \
  python3 "$SCRIPT" ecs --profile rev-qual >"$tmp_dir/ecs.out" 2>"$tmp_dir/ecs.err"

assert_contains "$BROWSER_CALLS" \
  'Destination=https%3A%2F%2Fconsole.aws.amazon.com%2Fecs%2Fv2%2Fhome%3Fregion%3Dsa-east-1'
assert_contains "$tmp_dir/ecs.err" 'aws-rev-qual'
if [[ -s "$tmp_dir/ecs.out" ]]; then
  printf 'service deep-link case wrote to stdout\n' >&2
  exit 1
fi

# --- iam --profile rev-qual: global service never carries a region ---------
: > "$BROWSER_CALLS"
env -u AWS_ACCESS_KEY_ID -u AWS_SECRET_ACCESS_KEY -u AWS_SESSION_TOKEN \
  "${COMMON_ENV_NO_REGION[@]}" \
  AWS_CONSOLE_BROWSER="$tmp_dir/fake-chrome" \
  AWS_SHARED_CREDENTIALS_FILE="$tmp_dir/credentials" \
  AWS_CONFIG_FILE="$tmp_dir/config" \
  python3 "$SCRIPT" iam --profile rev-qual >"$tmp_dir/iam.out" 2>"$tmp_dir/iam.err"

assert_contains "$BROWSER_CALLS" \
  'Destination=https%3A%2F%2Fconsole.aws.amazon.com%2Fiam%2Fhome&'
if grep -Fq 'region' "$BROWSER_CALLS"; then
  printf 'global service (iam) must not carry a region\n' >&2
  exit 1
fi

# A regionless profile cannot be exercised end-to-end here: the harness's
# AWS_ENDPOINT_URL_STS override makes botocore bypass the STS global-endpoint
# fallback, so a profile with no configured region fails at request signing
# before any deep-link logic runs. The no-region path is covered directly by
# the build_service_url("ecs", None) assertion in the helper block below.

# --- unknown service: exits non-zero listing the supported names -----------
: > "$BROWSER_CALLS"
: > "$REQUESTS_LOG"
if env "${COMMON_ENV[@]}" \
  AWS_ACCESS_KEY_ID=AKIABARE \
  AWS_SECRET_ACCESS_KEY=bare-secret \
  python3 "$SCRIPT" nosuchsvc >"$tmp_dir/unknown.out" 2>"$tmp_dir/unknown.err"; then
  printf 'unknown service must exit non-zero\n' >&2
  exit 1
fi
assert_contains "$tmp_dir/unknown.err" 'supported services'
assert_contains "$tmp_dir/unknown.err" 'ecs'
if [[ -s "$REQUESTS_LOG" ]]; then
  printf 'unknown service must fail before any AWS call\n' >&2
  exit 1
fi
if [[ -s "$BROWSER_CALLS" ]]; then
  printf 'unknown service launched a browser\n' >&2
  exit 1
fi

# --- ecs without --profile: default browser, still on the service page -----
: > "$BROWSER_CALLS"
env "${COMMON_ENV[@]}" \
  AWS_ACCESS_KEY_ID=AKIABARE \
  AWS_SECRET_ACCESS_KEY=bare-secret \
  python3 "$SCRIPT" ecs >"$tmp_dir/ecs-bare.out" 2>"$tmp_dir/ecs-bare.err"

assert_contains "$BROWSER_CALLS" \
  'Destination=https%3A%2F%2Fconsole.aws.amazon.com%2Fecs%2Fv2%2Fhome%3Fregion%3Dus-east-1'
if grep -Fq -- '--profile-directory=' "$BROWSER_CALLS"; then
  printf 'deep-link without --profile must not isolate\n' >&2
  exit 1
fi
if [[ -s "$tmp_dir/ecs-bare.err" ]]; then
  printf 'ecs deep-link without --profile wrote to stderr\n' >&2
  exit 1
fi

# --- ecs --stdout: service-aimed signin URL only on stdout ------------------
: > "$BROWSER_CALLS"
env "${COMMON_ENV[@]}" \
  AWS_ACCESS_KEY_ID=AKIABARE \
  AWS_SECRET_ACCESS_KEY=bare-secret \
  python3 "$SCRIPT" ecs --stdout >"$tmp_dir/ecs-stdout.out" 2>"$tmp_dir/ecs-stdout.err"

if [[ $(wc -l < "$tmp_dir/ecs-stdout.out") -ne 1 ]]; then
  printf 'ecs --stdout output must be exactly one line\n' >&2
  exit 1
fi
assert_contains "$tmp_dir/ecs-stdout.out" \
  'Destination=https%3A%2F%2Fconsole.aws.amazon.com%2Fecs%2Fv2%2Fhome%3Fregion%3Dus-east-1'
if [[ -s "$tmp_dir/ecs-stdout.err" ]]; then
  printf 'ecs --stdout case wrote to stderr\n' >&2
  exit 1
fi
if [[ -s "$BROWSER_CALLS" ]]; then
  printf 'ecs --stdout case launched a browser\n' >&2
  exit 1
fi

# --- the script remains a plain executable with the shebang unchanged -------
if [[ ! -x "$SCRIPT" ]]; then
  printf 'aws-console is not executable\n' >&2
  exit 1
fi
if ! head -n 1 "$SCRIPT" | grep -Fxq '#!python'; then
  printf 'aws-console shebang changed\n' >&2
  exit 1
fi

# --- pure helpers are importable and behave as specified --------------------
python3 - "$SCRIPT" <<'PY'
import importlib.machinery
import importlib.util
import os
import sys

path = sys.argv[1]
loader = importlib.machinery.SourceFileLoader("aws_console", path)
spec = importlib.util.spec_from_loader("aws_console", loader)
module = importlib.util.module_from_spec(spec)
loader.exec_module(module)

os.environ.pop("AWS_CONSOLE_FEDERATION_ENDPOINT", None)
assert module.federation_endpoint() == "https://signin.aws.amazon.com/federation"
os.environ["AWS_CONSOLE_FEDERATION_ENDPOINT"] = "http://stub:9999"
assert module.federation_endpoint() == "http://stub:9999"

assert module.build_destination("123456789012") == "https://console.aws.amazon.com/?account=123456789012"

token_url = module.build_get_signin_token_url(
    "http://stub:9999",
    {"sessionId": "A", "sessionKey": "B", "sessionToken": None},
)
assert token_url.startswith(
    "http://stub:9999?Action=getSigninToken&DurationSeconds=43200&Session="
)

login_url = module.build_login_url(
    "http://stub:9999",
    "https://console.aws.amazon.com/?account=123456789012",
    "TOKEN",
)
assert login_url.startswith(
    "http://stub:9999?Action=login&"
    "Destination=https%3A%2F%2Fconsole.aws.amazon.com%2F%3Faccount%3D123456789012"
    "&SigninToken=TOKEN&Issuer="
)

# --- binding sanitization -----------------------------------------------
os.environ.pop("AWS_CONSOLE_BROWSER", None)
assert module.sanitize_binding("rev-qual") == "rev-qual"
assert module.sanitize_binding("dev.account_1") == "dev.account_1"
assert module.sanitize_binding("rev qual!") == "rev-qual-"
assert module.sanitize_binding("a/b\\c") == "a-b-c"
assert module.build_binding("rev-qual") == "aws-rev-qual"
assert module.build_binding("dev account") == "aws-dev-account"

# --- per-OS browser resolution (pure function of the platform name) ------
assert module.resolve_browser("linux") == "google-chrome-stable"
assert (
    module.resolve_browser("darwin")
    == "/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge"
)
assert module.resolve_browser("win32") is None
assert module.resolve_browser("linux", "/custom/chrome") == "/custom/chrome"
assert module.resolve_browser("darwin", "edge-custom") == "edge-custom"
assert module.resolve_browser("win32", "chromium") == "chromium"

# --- Chromium-family heuristic and the isolation trigger -----------------
assert module.looks_chromium("google-chrome-stable")
assert module.looks_chromium("/opt/chromium/chrome")
assert module.looks_chromium(
    "/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge"
)
assert not module.looks_chromium("firefox")
assert not module.looks_chromium("/usr/bin/fake-browser")

assert module.should_isolate("rev-qual")
assert not module.should_isolate(None)
assert not module.should_isolate("default")

# --- service deep-links: curated table, global-vs-regional, region ---------
assert module.SERVICE_URLS == {
    "ecs": "https://console.aws.amazon.com/ecs/v2/home",
    "ec2": "https://console.aws.amazon.com/ec2/v2/home",
    "lambda": "https://console.aws.amazon.com/lambda/home",
    "s3": "https://console.aws.amazon.com/s3/home",
    "cloudwatch": "https://console.aws.amazon.com/cloudwatch/home",
    "logs": "https://console.aws.amazon.com/cloudwatch/home#logsV2:log-groups",
    "rds": "https://console.aws.amazon.com/rds/home",
    "dynamodb": "https://console.aws.amazon.com/dynamodb/home",
    "ecr": "https://console.aws.amazon.com/ecr/repositories",
    "iam": "https://console.aws.amazon.com/iam/home",
    "vpc": "https://console.aws.amazon.com/vpc/home",
    "route53": "https://console.aws.amazon.com/route53/home",
    "sns": "https://console.aws.amazon.com/sns/v3/home",
    "sqs": "https://console.aws.amazon.com/sqs/v3/home",
    "eks": "https://console.aws.amazon.com/eks/home",
}
assert module.GLOBAL_SERVICES == {"iam", "s3", "route53"}

assert (
    module.build_service_url("ecs", "sa-east-1")
    == "https://console.aws.amazon.com/ecs/v2/home?region=sa-east-1"
)
assert (
    module.build_service_url("ecs", None)
    == "https://console.aws.amazon.com/ecs/v2/home"
)
assert (
    module.build_service_url("logs", "us-east-1")
    == "https://console.aws.amazon.com/cloudwatch/home?region=us-east-1"
    "#logsV2:log-groups"
)
assert (
    module.build_service_url("iam", "sa-east-1")
    == "https://console.aws.amazon.com/iam/home"
)
assert (
    module.build_service_url("s3", "sa-east-1")
    == "https://console.aws.amazon.com/s3/home"
)
assert (
    module.build_service_url("route53", "sa-east-1")
    == "https://console.aws.amazon.com/route53/home"
)
try:
    module.build_service_url("nosuchsvc")
    raise AssertionError("unknown service must raise KeyError")
except KeyError:
    pass
PY

printf 'PASS\n'
