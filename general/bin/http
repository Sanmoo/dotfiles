#!/usr/bin/env python3
"""http — entry point for the REST client implementation in ``http_lib``.

The implementation lives in a separate importable module so CPython caches its
compiled bytecode in ``__pycache__`` and every invocation avoids recompiling
the 1800-line source. Keeping the entry point tiny matters here: the Open
Collection test suite runs this command over a hundred times, and process
startup dominates its wall time.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import http_lib

# Re-export the implementation's module-level names so callers that load this
# file directly (the test suite uses SourceFileLoader) see the same surface as
# before the split.
for _name, _value in vars(http_lib).items():
    if not _name.startswith("__"):
        globals()[_name] = _value

if __name__ == "__main__":
    sys.exit(main())
