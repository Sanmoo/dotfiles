# Keep Stow's built-in defaults because this package-local file replaces them.
RCS
.+,v
CVS
\.\#.+
\.cvsignore
\.svn
_darcs
\.hg
\.git
\.gitignore
\.gitmodules
.+~
\#.*\#
^/README.*
^/LICENSE.*
^/COPYING

# Herdr runtime state is generated in the folded package checkout.
^/.config/herdr/\.plugins\.lock$
^/.config/herdr/focus-state\.json$
^/.config/herdr/herdr-client\.log$
^/.config/herdr/herdr-server\.log$
^/.config/herdr/herdr\.sock\.agent$
^/.config/herdr/plugins\.json$
^/.config/herdr/release-notes\.json$
^/.config/herdr/session\.json$
^/.config/herdr/sessions$
^/.config/herdr/session-snapshots$
^/.local/share/herdr-recent-navigator/herdr-plugin\.toml$
