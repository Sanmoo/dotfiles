#!/usr/bin/env bash
# safe-pi — run Pi in a throwaway Docker container.
#
# Installed by stow as part of the `pi` package. The script resolves its own
# real path (following the stow symlink) to find the build context beside the
# repository, builds the image on first use, and runs Pi in the container.
# Script-owned flags are consumed; every other argument reaches Pi unchanged.
set -euo pipefail

readonly SCRIPT_NAME="safe-pi"
readonly IMAGE_REPO="safe-pi"
readonly SANDBOX_MARKER="SAFE_PI_SANDBOX"
# Darwin means the Docker daemon runs in a VM (ADR 0008); an absent uname is
# treated as Linux.
HOST_OS="$(uname -s 2>/dev/null || true)"
readonly HOST_OS

usage() {
	cat <<'USAGE'
Usage: safe-pi [safe-pi flags] [--] [pi arguments...]

Run Pi in a throwaway Docker container that sees the current directory.

Script flags (never forwarded to Pi):
  --rebuild   rebuild the current image tag with the version it already has
  --update    resolve the latest Pi release and re-point the current tag
  --shell     start a shell in the sandbox instead of Pi
  --prepare   converge the declared environment and exit without starting Pi
  --dry-run   print the Docker invocation and exit
  help        print this message

-h, --help, and --version are forwarded to Pi.
USAGE
}

# Preflight failures (usage, root, missing Docker, missing build context).
die() {
	printf '%s: %s\n' "$SCRIPT_NAME" "$1" >&2
	exit 2
}

# --- Re-entry guard -----------------------------------------------------------
# The wrapper exports this marker into the container. Seeing it means we are
# already inside the sandbox, so run Pi directly instead of nesting containers.
if [[ -n "${!SANDBOX_MARKER-}" ]]; then
	exec pi "$@"
fi

# --- Parse script-owned flags -------------------------------------------------
MODE="run"
REBUILD=0
UPDATE=0
DRY_RUN=0
pi_args=()

if [[ "${1-}" == "help" ]]; then
	usage
	exit 0
fi

while (($#)); do
	case "$1" in
	--)
		shift
		pi_args+=("$@")
		break
		;;
	--rebuild)
		REBUILD=1
		shift
		;;
	--update)
		UPDATE=1
		shift
		;;
	--shell)
		[[ "$MODE" != "prepare" ]] || die "use either --prepare or --shell, not both"
		MODE="shell"
		shift
		;;
	--prepare)
		[[ "$MODE" != "shell" ]] || die "use either --prepare or --shell, not both"
		MODE="prepare"
		shift
		;;
	--dry-run)
		DRY_RUN=1
		shift
		;;
	*)
		pi_args+=("$1")
		shift
		;;
	esac
done

if ((REBUILD && UPDATE)); then
	die "use either --rebuild or --update, not both"
fi
if [[ "$MODE" == "prepare" ]] && ((${#pi_args[@]})); then
	die "--prepare converges the declared environment and starts nothing, so it takes no Pi arguments"
fi

# --- Preflight ----------------------------------------------------------------
if [[ "$(id -u)" -eq 0 ]]; then
	die "refusing to run as root; container file ownership depends on your uid"
fi

# Resolve the build context through the installed symlink. `readlink -f`
# follows the stow symlink into the repository; deriving the directory from
# BASH_SOURCE alone would point at the installed location.
resolve_build_context() {
	local script_real script_dir repo_root
	script_real="$(readlink -f "${BASH_SOURCE[0]}")"
	script_dir="$(dirname "$script_real")"
	repo_root="$(cd "$script_dir/../../.." 2>/dev/null && pwd)" || repo_root=""
	# The configuration checkout is the repository this script is installed
	# from. Pi's settings, keybindings, prompts, extensions, and pi-lens
	# configuration are symlinks into it, so the container needs it mounted.
	CONFIG_CHECKOUT="${repo_root:-}"

	local override="${SAFE_PI_BUILD_CONTEXT-}"
	if [[ -n "$override" ]]; then
		if [[ -f "$override" ]]; then
			DOCKERFILE="$(readlink -f "$override")"
			BUILD_CONTEXT="$(dirname "$DOCKERFILE")"
		elif [[ -d "$override" ]]; then
			BUILD_CONTEXT="$(readlink -f "$override")"
			DOCKERFILE="$BUILD_CONTEXT/Dockerfile"
		else
			die "SAFE_PI_BUILD_CONTEXT points at '$override', which does not exist"
		fi
		return
	fi

	BUILD_CONTEXT="${repo_root:+$repo_root/safe-pi}"
	DOCKERFILE="${BUILD_CONTEXT:+$BUILD_CONTEXT/Dockerfile}"
}

resolve_build_context
if [[ ! -f "$DOCKERFILE" ]]; then
	die "cannot find the safe-pi build context (expected $DOCKERFILE); the script was probably copied instead of installed by stow — set SAFE_PI_BUILD_CONTEXT to its Dockerfile or directory"
fi

# --- Image identity -----------------------------------------------------------
CURRENT_TAG="$IMAGE_REPO:current-u$(id -u)"

version_tag() {
	printf '%s:pi-%s-u%s' "$IMAGE_REPO" "$1" "$(id -u)"
}

image_exists() {
	docker image inspect "$1" >/dev/null 2>&1
}

image_pi_version() {
	docker image inspect --format '{{ index .Config.Labels "safe-pi.pi.version" }}' "$1" 2>/dev/null
}

# The entrypoint label versions the sandbox's convergence contract: 2 added the
# reporter, 3 the precompiled OTP target, 4 the sandbox locale, 5 the reporter's
# pane release, 6 the image's stow and PyYAML, 7 zsh, 8 the host's home as the
# sandbox user's. An image carrying anything else is stale and rebuilt, so the
# change reaches a machine that already has one.
image_has_entrypoint() {
	[[ "$(docker image inspect --format '{{ index .Config.Labels "safe-pi.entrypoint" }}' "$1" 2>/dev/null || true)" == "8" ]]
}

# The sandbox user's home is the host's, so an image built for another home (a
# different machine's, or a different user's) is stale.
image_has_home() {
	[[ "$(docker image inspect --format '{{ index .Config.Labels "safe-pi.home" }}' "$1" 2>/dev/null || true)" == "$HOME" ]]
}

# Prints why an image must be rebuilt, or nothing when it is current.
image_stale_reason() {
	if ! image_has_entrypoint "$1"; then
		printf 'an older sandbox entrypoint'
	elif ! image_has_home "$1"; then
		printf 'another home directory'
	fi
}

build_image() { # $1 = tag, $2 = optional Pi version
	local tag="$1" version="${2-}"
	local args=(
		build
		--tag "$tag"
		--build-arg "UID=$(id -u)"
		--build-arg "GID=$(id -g)"
		--build-arg "USERNAME=$(id -un)"
		--build-arg "USER_HOME=$HOME"
	)
	if [[ -n "$version" ]]; then
		args+=(--build-arg "PI_VERSION=$version")
	fi
	args+=(--file "$DOCKERFILE" "$BUILD_CONTEXT")
	docker "${args[@]}"
}

# Record the baked Pi version as its own tag, so --update can reuse it.
tag_baked_version() {
	local version
	version="$(image_pi_version "$CURRENT_TAG" || true)"
	if [[ -n "$version" ]]; then
		docker tag "$CURRENT_TAG" "$(version_tag "$version")"
	fi
}

resolve_latest_pi_version() {
	npm view @earendil-works/pi-coding-agent version 2>/dev/null | tail -n1
}

# --- Container contract -------------------------------------------------------
# Mounts and environment the sandbox runs with. Everything hangs off the
# invoking user's home and the configuration checkout, and is mounted at its
# host path so absolute paths in prompts, tool output, and repository metadata
# stay valid. The sessions directory is the one exception: Pi reports it at a
# container-only path so Herdr's host-side restore cannot start an
# unsandboxed Pi.
PI_AGENT_DIR="$HOME/.pi/agent"
HOST_SESSION_DIR="$PI_AGENT_DIR/sessions"
SHARED_SKILLS_DIR="$HOME/.agents/skills"
PI_LENS_DIR="$HOME/.pi-lens"
MISE_CONFIG_DIR="${CONFIG_CHECKOUT:+$CONFIG_CHECKOUT/mise/.config/mise}"
HERDR_CONFIG_DIR="$HOME/.config/herdr"
GIT_CONFIG_FILE="$HOME/.gitconfig"

CONTAINER_SESSION_DIR="/run/safe-pi/sessions"
CONTAINER_REPORTER="/usr/local/share/safe-pi/herdr-reporter.ts"
CONTAINER_MISE_CONFIG_DIR="$HOME/.config/mise"
CONTAINER_MISE_DATA_DIR="$HOME/.local/share/mise"
# Mise's cache sits inside the toolchain volume, so remote version lookups
# survive container restarts instead of being refetched on every start.
CONTAINER_MISE_CACHE_DIR="$CONTAINER_MISE_DATA_DIR/cache"
CONTAINER_MISE_STATE_DIR="$CONTAINER_MISE_DATA_DIR/state"
CONTAINER_SSH_SOCK="/run/safe-pi/ssh-agent.sock"
# Where a relayed Herdr socket lands on macOS. Not the host path: that sits in
# the shared home, where the daemon cannot resolve a socket to mount over.
CONTAINER_HERDR_SOCK="/run/safe-pi/herdr.sock"
# jiti compiles the TypeScript extensions Pi loads and caches the result under
# the temporary directory (`$TMPDIR/jiti`), which the sandbox throws away on
# every start: a cold compile of this extension set is about ten seconds of CPU
# before Pi draws its first frame. The cache is bound outside the container
# instead, in a directory private to the sandbox. It is deliberately not the
# host's own `/tmp/jiti`: a cache entry is a module the host Pi executes, so a
# sandbox-writable cache the host reads would undo what the read-only extension
# and npm mounts are for.
HOST_JITI_CACHE_DIR="$HOME/.cache/safe-pi/jiti"
CONTAINER_JITI_CACHE_DIR="/tmp/jiti"

# Pi groups sessions by working directory. The container-only sessions path
# mirrors that grouping so a session written in the sandbox lands in the same
# host subdirectory the host Pi reads, and continues work started on either
# side. Pi uses the directory it is given verbatim (it does not append the cwd
# again), so the encoding has to match Pi's own exactly.
encode_cwd() {
	local path="${1#/}"
	path="${path//[\/\\:]/-}"
	printf -- '--%s--' "$path"
}
CONTAINER_PROJECT_SESSION_DIR="$CONTAINER_SESSION_DIR/$(encode_cwd "$PWD")"
# Keyed to the invoking user: one toolchain volume per user, shared by every
# repository so per-repository pins are downloaded once.
TOOLCHAIN_VOLUME="safe-pi-toolchain-u$(id -u)"

# Pi locks its credential store by creating a file beside the credential file,
# so the agent directory has to exist and be writable before it starts. The
# directories are created only when the sandbox is really about to start, so a
# dry run never touches the host.
mount_args=()
contract_paths=() # "container-path:mode" for the debug shell
missing_paths=()  # contract paths absent on the host

# A bind is `--mount type=bind`, never `--volume`: a source the daemon cannot see
# is an error instead of a directory the daemon creates in its own filesystem.
# --mount is comma-separated, so a field holding a comma or a quote is quoted.
mount_field() { # $1 = key, $2 = value
	local value="$2"
	if [[ "$value" == *[,\"]* ]]; then
		value="\"$1=${value//\"/\"\"}\""
		printf '%s' "$value"
	else
		printf '%s=%s' "$1" "$value"
	fi
}

bind_mount_arg() { # $1 = host path, $2 = container path, $3 = mode
	local arg="type=bind,$(mount_field source "$1"),$(mount_field target "$2")"
	[[ "$3" == "ro" ]] && arg+=",readonly"
	printf '%s' "$arg"
}

record_mount() { # $1 = host path, $2 = container path, $3 = mode
	mount_args+=(--mount "$(bind_mount_arg "$1" "$2" "$3")")
	contract_paths+=("$2:$3")
}

record_volume() { # $1 = volume, $2 = container path, $3 = mode
	mount_args+=(--volume "$1:$2:$3")
	contract_paths+=("$2:$3")
}

add_mount() { # optional bind mount; skipped, and reported, when absent
	[[ -e "$1" ]] || {
		missing_paths+=("$2:$3")
		return 0
	}
	record_mount "$1" "$2" "$3"
}

# The working repository, the agent directory, the sessions directory, and the
# toolchain volume are the contract's fixed points: always mounted at their host
# path, whether or not a dry run can see them yet.
record_mount "$PWD" "$PWD" rw
record_mount "$PI_AGENT_DIR" "$PI_AGENT_DIR" rw
record_mount "$HOST_SESSION_DIR" "$CONTAINER_SESSION_DIR" rw
# The toolchain volume is always mounted, even before anything is installed:
# its content is the declared environment, not image content.
record_volume "$TOOLCHAIN_VOLUME" "$CONTAINER_MISE_DATA_DIR" rw
# The transpile cache is a fixed point of the contract too: it is always
# mounted at the path jiti looks in, so a start reuses the extensions it already
# compiled. The destination is deeper than the temporary directory, so the bind
# wins over the tmpfs and the rest of `/tmp` stays ephemeral.
record_mount "$HOST_JITI_CACHE_DIR" "$CONTAINER_JITI_CACHE_DIR" rw

# Installed code is held immutable while agent state stays writable. The mount
# stays at its own path so the host's relative extension symlinks keep
# resolving; the Herdr-managed integration is neutralised by withholding the
# variables that activate it (see the environment below), not by hiding it.
add_mount "$PI_AGENT_DIR/extensions" "$PI_AGENT_DIR/extensions" ro
add_mount "$PI_AGENT_DIR/npm" "$PI_AGENT_DIR/npm" ro
add_mount "$SHARED_SKILLS_DIR" "$SHARED_SKILLS_DIR" ro
# The checkout is read-only unless the working directory *is* the checkout; a
# working directory inside it keeps its read-write mount, because Docker orders
# nested mounts by depth and the deeper working-directory mount wins.
if [[ -n "$CONFIG_CHECKOUT" && "$PWD" != "$CONFIG_CHECKOUT" ]]; then
	add_mount "$CONFIG_CHECKOUT" "$CONFIG_CHECKOUT" ro
fi
add_mount "$PI_LENS_DIR" "$PI_LENS_DIR" rw
add_mount "$MISE_CONFIG_DIR" "$CONTAINER_MISE_CONFIG_DIR" ro
add_mount "$HERDR_CONFIG_DIR" "$HERDR_CONFIG_DIR" ro
add_mount "$GIT_CONFIG_FILE" "$GIT_CONFIG_FILE" ro

# Environment: identity and terminal variables Pi and its tools need, the
# container-only paths, and the Herdr variables forwarded only when the host
# sets them. `--env NAME` forwards the value from this process's environment.
forward_env() { # names to forward from this process's environment
	local name
	for name in "$@"; do
		[[ -n "${!name-}" ]] || continue
		env_args+=(--env "$name")
	done
}

env_args=(--env "$SANDBOX_MARKER=1")
forward_env HOME USER LANG LC_ALL LC_CTYPE TERM TZ
env_args+=(--env "MISE_DATA_DIR=$CONTAINER_MISE_DATA_DIR")
env_args+=(--env "MISE_CACHE_DIR=$CONTAINER_MISE_CACHE_DIR")
env_args+=(--env "MISE_STATE_DIR=$CONTAINER_MISE_STATE_DIR")
env_args+=(--env "PI_CODING_AGENT_SESSION_DIR=$CONTAINER_PROJECT_SESSION_DIR")
# Herdr's own process variables are deliberately NOT forwarded under those
# names: the Herdr-managed integration activates on HERDR_ENV/HERDR_SOCKET_PATH/
# HERDR_PANE_ID, and leaving it unactivated is what keeps exactly one source
# (the reporter below) owning the pane. The reporter gets the socket and pane
# under sandbox-owned names instead.
# On macOS the socket is named only once the relay has put it in the VM.
if [[ "${HERDR_ENV-}" == "1" && -n "${HERDR_SOCKET_PATH-}" && -n "${HERDR_PANE_ID-}" ]]; then
	if [[ "$HOST_OS" != "Darwin" ]]; then
		env_args+=(--env "SAFE_PI_HERDR_SOCKET_PATH=$HERDR_SOCKET_PATH")
	fi
	env_args+=(--env "SAFE_PI_HERDR_PANE_ID=$HERDR_PANE_ID")
fi

# --- Host sockets -------------------------------------------------------------
# The invoking shell's SSH agent, and Herdr's socket, reach the sandbox only
# when the host provides them. On Linux the daemon shares the host's filesystem,
# so the SSH agent socket is bind-mounted by path (Herdr's is reachable through
# its mounted directory). On macOS the daemon runs in the Colima VM (ADR 0008),
# which sees neither and cannot connect to a host socket through the share, so
# each is relayed into the VM over the sandbox's own SSH connection and the
# forwarded socket is mounted instead.
relay_names=()      # short name, also the forwarded socket's file name in the VM
relay_hosts=()      # host socket path
relay_containers=() # path the sandbox sees
relay_labels=()     # what the warning calls it
relay_ok=()         # "1" once the forward is up (or assumed up, for a dry run)

add_relay() { # $1 = name, $2 = host socket, $3 = container path, $4 = label
	relay_names+=("$1")
	relay_hosts+=("$2")
	relay_containers+=("$3")
	relay_labels+=("$4")
	relay_ok+=("")
}

if [[ -n "${SSH_AUTH_SOCK-}" && -S "${SSH_AUTH_SOCK}" ]]; then
	if [[ "$HOST_OS" == "Darwin" ]]; then
		add_relay ssh-agent "$SSH_AUTH_SOCK" "$CONTAINER_SSH_SOCK" "SSH agent"
	else
		add_mount "$SSH_AUTH_SOCK" "$CONTAINER_SSH_SOCK" rw
		env_args+=(--env "SSH_AUTH_SOCK=$CONTAINER_SSH_SOCK")
	fi
fi
if [[ "$HOST_OS" == "Darwin" && "${HERDR_ENV-}" == "1" && -n "${HERDR_PANE_ID-}" &&
	-n "${HERDR_SOCKET_PATH-}" && -S "${HERDR_SOCKET_PATH}" ]]; then
	add_relay herdr "$HERDR_SOCKET_PATH" "$CONTAINER_HERDR_SOCK" "Herdr socket"
fi

# --- Socket relay (macOS) -----------------------------------------------------
# One SSH connection per sandbox start, to the Colima VM, on its own control
# path (not Lima's persistent master, whose config says Lima does not use it).
# It carries one remote unix-socket forward per host socket into a directory
# private to this start, and is closed, with the directory, when the sandbox
# exits. Opening it costs about 0.9 s, so it opens in the background while the
# image checks run.
RELAY_DIR=""    # host directory holding the control socket and the results
RELAY_PID=""
RELAY_ALIAS=""  # Host alias in ~/.colima/ssh_config
RELAY_CTL=""
RELAY_VM_DIR="" # private directory inside the VM

# Colima names its daemon `colima`, or `colima-<profile>`, which is also the
# Host alias in the ssh_config it writes.
colima_alias_of() { # $1 = docker info Name
	case "$1" in
	colima | colima-?*) printf '%s' "$1" ;;
	*) return 1 ;;
	esac
}

refuse_unsupported_daemon() {
	die "safe-pi on macOS supports Colima only (the Docker daemon here is '${1:-unknown}')"
}

relay_ssh() { # $@ = ssh arguments; the host alias is the caller's
	ssh -F "$HOME/.colima/ssh_config" -o BatchMode=yes -o ConnectTimeout=10 \
		-o LogLevel=ERROR "$@"
}

# The relay's commands, for one start. Held in arrays so that the real run and
# the dry run print and execute exactly the same thing.
plan_relay() { # $1 = host directory, $2 = VM directory suffix, $3 = alias
	RELAY_DIR="$1"
	RELAY_ALIAS="$3"
	RELAY_CTL="$1/c"
	RELAY_VM_DIR="/tmp/safe-pi.$2"
	RELAY_MASTER=(-M -S "$RELAY_CTL" -f -N -o ControlPersist=no -o ExitOnForwardFailure=yes
		-o StreamLocalBindUnlink=yes "$RELAY_ALIAS")
	RELAY_MKDIR=(-S "$RELAY_CTL" "$RELAY_ALIAS" -- mkdir -m 0700 -- "$RELAY_VM_DIR")
}

relay_forward_args() { # $1 = index; sets RELAY_FORWARD
	RELAY_FORWARD=(-S "$RELAY_CTL" -O forward
		-R "$RELAY_VM_DIR/${relay_names[$1]}.sock:${relay_hosts[$1]}" "$RELAY_ALIAS")
}

relay_vm_socket() { # $1 = index
	printf '%s/%s.sock' "$RELAY_VM_DIR" "${relay_names[$1]}"
}

# Runs in the background. Leaves one status file per socket: `ok`, or the reason
# the socket is unavailable.
open_relay() {
	local i reason
	local fail_all=""
	if ! relay_ssh "${RELAY_MASTER[@]}" </dev/null >/dev/null 2>"$RELAY_DIR/err"; then
		fail_all="$(relay_reason "$RELAY_DIR/err" "cannot open an SSH connection to the Colima VM")"
	else
		: >"$RELAY_DIR/master.ok"
		if ! relay_ssh "${RELAY_MKDIR[@]}" </dev/null >/dev/null 2>"$RELAY_DIR/err"; then
			fail_all="$(relay_reason "$RELAY_DIR/err" "cannot create the relay directory in the Colima VM")"
		fi
	fi
	for i in "${!relay_names[@]}"; do
		if [[ -n "$fail_all" ]]; then
			printf '%s\n' "$fail_all" >"$RELAY_DIR/${relay_names[$i]}.status"
			continue
		fi
		relay_forward_args "$i"
		if relay_ssh "${RELAY_FORWARD[@]}" </dev/null >/dev/null 2>"$RELAY_DIR/err"; then
			printf 'ok\n' >"$RELAY_DIR/${relay_names[$i]}.status"
		else
			reason="$(relay_reason "$RELAY_DIR/err" "the forward was refused")"
			printf '%s\n' "$reason" >"$RELAY_DIR/${relay_names[$i]}.status"
		fi
	done
}

relay_reason() { # $1 = stderr file, $2 = fallback
	local line=""
	[[ -s "$1" ]] && line="$(head -n1 "$1")"
	printf '%s' "${line:-$2}"
}

start_relay() { # $1 = alias
	((${#relay_names[@]})) || return 0
	local dir
	dir="$(mktemp -d "${TMPDIR:-/tmp}/safe-pi.XXXXXX")"
	plan_relay "$dir" "${dir##*.}" "$1"
	trap close_relay EXIT
	trap 'exit 130' INT
	trap 'exit 143' TERM HUP
	open_relay &
	RELAY_PID=$!
}

# Waits for the relay, warns per socket that did not come up, and mounts the
# ones that did.
finish_relay() {
	local i status
	[[ -n "$RELAY_DIR" ]] || return 0 # no relay was started (--prepare, or no sockets)
	wait "$RELAY_PID" 2>/dev/null || true
	for i in "${!relay_names[@]}"; do
		status="$(head -n1 "$RELAY_DIR/${relay_names[$i]}.status" 2>/dev/null || true)"
		if [[ "$status" == "ok" ]]; then
			relay_ok[i]=1
		else
			printf '%s: %s unavailable in the sandbox: %s\n' "$SCRIPT_NAME" "${relay_labels[$i]}" \
				"${status:-the relay did not finish}" >&2
		fi
	done
}

close_relay() {
	[[ -n "$RELAY_DIR" ]] || return 0
	wait "$RELAY_PID" 2>/dev/null || true
	if [[ -e "$RELAY_DIR/master.ok" || -S "$RELAY_CTL" ]]; then
		relay_ssh -S "$RELAY_CTL" "$RELAY_ALIAS" -- rm -rf -- "$RELAY_VM_DIR" </dev/null >/dev/null 2>&1 || true
		relay_ssh -S "$RELAY_CTL" -O exit "$RELAY_ALIAS" </dev/null >/dev/null 2>&1 || true
	fi
	rm -rf "$RELAY_DIR"
	RELAY_DIR=""
}

# Mounts each forwarded socket in the sandbox and points its variable at it.
mount_relayed_sockets() {
	local i
	for i in "${!relay_names[@]}"; do
		[[ -n "${relay_ok[$i]}" ]] || continue
		record_mount "$(relay_vm_socket "$i")" "${relay_containers[$i]}" rw
		case "${relay_names[$i]}" in
		ssh-agent) env_args+=(--env "SSH_AUTH_SOCK=$CONTAINER_SSH_SOCK") ;;
		herdr) env_args+=(--env "SAFE_PI_HERDR_SOCKET_PATH=$CONTAINER_HERDR_SOCK") ;;
		esac
	done
}

# A debug shell prints the contract it landed in before handing over a shell.
build_shell_banner() {
	local script entry path mode
	# The generated script is expanded inside the sandbox, not here.
	# shellcheck disable=SC2016
	script+='printf "safe-pi sandbox\n"; id; printf "cwd: %s\n" "$PWD"; '
	# shellcheck disable=SC2016
	script+='report() { if [ -e "$1" ]; then printf "  present  %s  (%s)\n" "$1" "$2"; else printf "  MISSING  %s  (%s)\n" "$1" "$2"; fi; }; '
	for entry in "${contract_paths[@]}" "${missing_paths[@]}"; do
		path="${entry%:*}"
		mode="${entry##*:}"
		script+="report $(printf '%q' "$path") $(printf '%q' "$mode"); "
	done
	script+='exec bash'
	SHELL_BANNER="$script"
}

# --- Resolve the Docker invocation before touching Docker ---------------------
build_run_args() {
	run_args=(
		run
		--rm
	)
	if [[ -t 0 && -t 1 ]]; then
		run_args+=(--interactive --tty)
	fi
	run_args+=(--workdir "$PWD")
	run_args+=("${mount_args[@]}")
	# The temporary directory is writable but thrown away with the container.
	run_args+=(--tmpfs /tmp)
	run_args+=("${env_args[@]}")
	run_args+=("$CURRENT_TAG")
	# The image's entrypoint converges the declared environment before whatever
	# command follows the image name runs.
	case "$MODE" in
	shell)
		build_shell_banner
		run_args+=(bash -c "$SHELL_BANNER")
		;;
	prepare)
		run_args+=(--prepare)
		;;
	*)
		# The sandbox reporter is loaded explicitly: it lives in the image, and the
		# host extensions directory is mounted read-only at its own path.
		run_args+=(pi -e "$CONTAINER_REPORTER")
		;;
	esac
	if ((${#pi_args[@]})); then
		run_args+=("${pi_args[@]}")
	fi
}

# --- Dry run: print the invocation without touching Docker --------------------
if ((DRY_RUN)); then
	if [[ "$HOST_OS" == "Darwin" ]] && ((${#relay_names[@]})) && [[ "$MODE" != "prepare" ]]; then
		# The profile is the one thing a dry run asks the daemon; with none
		# reachable it assumes the default. The relay is printed, never run.
		dry_name="$(docker info --format '{{.Name}}' 2>/dev/null || true)"
		dry_alias="colima"
		if [[ -n "$dry_name" ]]; then
			dry_alias="$(colima_alias_of "$dry_name")" || refuse_unsupported_daemon "$dry_name"
		fi
		plan_relay "${TMPDIR:-/tmp}/safe-pi.XXXXXX" XXXXXX "$dry_alias"
		printf 'ssh -F %q' "$HOME/.colima/ssh_config"
		printf ' %q' "${RELAY_MASTER[@]}"
		printf '\n'
		printf 'ssh -F %q' "$HOME/.colima/ssh_config"
		printf ' %q' "${RELAY_MKDIR[@]}"
		printf '\n'
		for i in "${!relay_names[@]}"; do
			relay_forward_args "$i"
			printf 'ssh -F %q' "$HOME/.colima/ssh_config"
			printf ' %q' "${RELAY_FORWARD[@]}"
			printf '\n'
			relay_ok[i]=1
		done
		mount_relayed_sockets
	fi
	build_run_args
	printf 'docker'
	printf ' %q' "${run_args[@]}"
	printf '\n'
	exit 0
fi

# --- Docker presence ----------------------------------------------------------
if ! command -v docker >/dev/null 2>&1; then
	die "Docker is not installed or not on PATH"
fi
if [[ "$HOST_OS" == "Darwin" ]]; then
	daemon_name="$(docker info --format '{{.Name}}' 2>/dev/null)" ||
		die "cannot reach the Docker daemon; is it running and accessible to you?"
	daemon_alias="$(colima_alias_of "$daemon_name")" || refuse_unsupported_daemon "$daemon_name"
	# --prepare converges the toolchain volume and needs neither socket.
	if [[ "$MODE" != "prepare" ]]; then
		start_relay "$daemon_alias"
	fi
elif ! docker info >/dev/null 2>&1; then
	die "cannot reach the Docker daemon; is it running and accessible to you?"
fi

# --- Build only when the current tag is absent or stale -----------------------
if ((UPDATE)); then
	latest="$(resolve_latest_pi_version)" || latest=""
	if [[ -z "$latest" ]]; then
		printf '%s: could not resolve the latest Pi release with npm\n' "$SCRIPT_NAME" >&2
		exit 1
	fi
	latest_tag="$(version_tag "$latest")"
	if ! image_exists "$latest_tag" || [[ -n "$(image_stale_reason "$latest_tag")" ]]; then
		build_image "$latest_tag" "$latest"
	fi
	docker tag "$latest_tag" "$CURRENT_TAG"
elif ((REBUILD)); then
	version="$(image_pi_version "$CURRENT_TAG" || true)"
	build_image "$CURRENT_TAG" "$version"
	tag_baked_version
elif ! image_exists "$CURRENT_TAG"; then
	build_image "$CURRENT_TAG"
	tag_baked_version
elif stale_reason="$(image_stale_reason "$CURRENT_TAG")" && [[ -n "$stale_reason" ]]; then
	printf '%s: the current image carries %s; rebuilding it\n' "$SCRIPT_NAME" "$stale_reason" >&2
	version="$(image_pi_version "$CURRENT_TAG" || true)"
	build_image "$CURRENT_TAG" "$version"
	tag_baked_version
fi

# --- Version drift ------------------------------------------------------------
# Surface a difference between the image's baked Pi and the host's Pi, so
# following Pi releases on the host does not silently diverge from the sandbox.
warn_on_version_drift() {
	local baked host_version
	baked="$(image_pi_version "$CURRENT_TAG" || true)"
	[[ -n "$baked" ]] || return 0
	command -v pi >/dev/null 2>&1 || return 0
	host_version="$(pi --version 2>/dev/null || true)"
	host_version="${host_version##* }"
	[[ -n "$host_version" ]] || return 0
	if [[ "$host_version" != "$baked" ]]; then
		printf '%s: warning: the image has Pi %s but the host has Pi %s; run safe-pi --update to refresh the image\n' \
			"$SCRIPT_NAME" "$baked" "$host_version" >&2
	fi
}

# --- Ensure required host mount points exist ----------------------------------
# Docker creates a missing bind source as a root-owned directory on the host, so
# the agent, sessions, and transpile cache directories are created as the
# invoking user first. jiti refuses a cache directory it cannot write, and a
# root-owned one would leave it recompiling the extension set on every start.
mkdir -p "$PI_AGENT_DIR" "$HOST_SESSION_DIR" "$HOST_JITI_CACHE_DIR"

# --- Run Pi in the sandbox ----------------------------------------------------
if [[ "$MODE" != "prepare" ]]; then
	warn_on_version_drift
fi
finish_relay
mount_relayed_sockets
build_run_args
docker "${run_args[@]}"
