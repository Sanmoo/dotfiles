#!/usr/bin/env bash
# pi-deere — a second Pi profile for the second GitHub Copilot account.
#
# Installed by stow as part of the `pi` package. The launcher prepares a private
# agent profile (its own auth.json) whose resources are symlinks into the agent
# directory of the original Pi, then execs the installed `pi` with that profile.
# Nothing here replaces `pi`: the original profile and its logins are untouched.
#
#   PI_CODING_AGENT_DIR            original agent dir (default ~/.pi/agent)
#   PI_DEERE_AGENT_DIR             second profile dir (default ~/.pi-deere/agent)
#
# Sessions are shared by linking the profile's sessions/ to the original one.
# Pi keeps its per-project grouping (sessions/--<cwd>--/) under the default
# layout, so no session-dir override is exported. A caller-supplied
# PI_CODING_AGENT_SESSION_DIR is inherited unchanged, as Pi would use it.
#
# Every argument is forwarded to Pi unchanged, and `exec` hands Pi the process,
# so signals and the exit status are Pi's own.
set -euo pipefail

readonly SCRIPT_NAME="pi-deere"

# Resources shared with the original profile by symlink. Each one is linked only
# when it exists in the source, so a later addition is picked up on the next
# launch. settings.json is not listed: it is copied (see refresh_settings).
# Credentials and per-profile runtime state (auth.json, mcp-oauth/, run history,
# MCP caches, trust decisions, subagent and intercom state) stay private.
readonly SHARED_ENTRIES=(
	AGENTS.md
	agents
	bin
	extensions
	git
	keybindings.json
	mcp-adapter.json
	models-store.json
	models.json
	npm
	prompts
	sessions
	skills
	themes
	tools
)

# Pi recognises these only as the first argument; they are passed through as is.
readonly PI_SUBCOMMANDS="install remove uninstall update list config auth mcp"

readonly COPILOT_PROVIDER="github-copilot"

die() {
	printf '%s: %s\n' "$SCRIPT_NAME" "$1" >&2
	exit "${2:-1}"
}

# Expand a leading ~ the way Pi does for its own directory variables.
expand_home() {
	case "$1" in
	"~") printf '%s' "$HOME" ;;
	"~/"*) printf '%s/%s' "$HOME" "${1#\~/}" ;;
	*) printf '%s' "$1" ;;
	esac
}

SOURCE_DIR="$(expand_home "${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}")"
PROFILE_DIR="$(expand_home "${PI_DEERE_AGENT_DIR:-$HOME/.pi-deere/agent}")"

source_has() {
	[[ -e "$SOURCE_DIR/$1" || -L "$SOURCE_DIR/$1" ]]
}

# --- Profile preparation ------------------------------------------------------
# Validation runs before any change, so a conflict leaves the profile as it was.
prepare_profile() {
	[[ -d "$SOURCE_DIR" ]] ||
		die "agent directory of the original Pi not found: $SOURCE_DIR (set PI_CODING_AGENT_DIR or install the pi package)"
	[[ -e "$SOURCE_DIR/settings.json" ]] ||
		die "missing $SOURCE_DIR/settings.json; the shared preferences cannot be loaded"
	[[ "$SOURCE_DIR" != "$PROFILE_DIR" ]] ||
		die "PI_DEERE_AGENT_DIR must differ from the original agent directory"

	# Pi creates sessions/ on first use; creating it here lets the link exist before that.
	mkdir -p "$SOURCE_DIR/sessions"

	local entry src dst target
	local -a to_link=()
	for entry in "${SHARED_ENTRIES[@]}"; do
		source_has "$entry" || continue
		src="$SOURCE_DIR/$entry"
		dst="$PROFILE_DIR/$entry"
		if [[ -L "$dst" ]]; then
			target="$(readlink "$dst")"
			[[ "$target" == "$src" ]] && continue
			die "conflict: $dst is a link to $target, expected $src; nothing was changed (remove or move the link and run again)"
		fi
		[[ -e "$dst" ]] &&
			die "conflict: $dst exists and is not the shared $entry; nothing was changed (move it aside and run again)"
		to_link+=("$entry")
	done

	[[ ! -L "$PROFILE_DIR/auth.json" ]] ||
		die "conflict: $PROFILE_DIR/auth.json is a link; the second profile must keep its own credentials"

	mkdir -p "$PROFILE_DIR"
	chmod 700 "$PROFILE_DIR"
	for entry in ${to_link[@]+"${to_link[@]}"}; do
		ln -s "$SOURCE_DIR/$entry" "$PROFILE_DIR/$entry"
	done
	refresh_settings

	# Post-check: every shared entry present in the source must resolve from the profile.
	for entry in "${SHARED_ENTRIES[@]}"; do
		if source_has "$entry" && [[ ! -e "$PROFILE_DIR/$entry" ]]; then
			die "shared $entry is a broken link: $SOURCE_DIR/$entry does not resolve"
		fi
	done
}

# settings.json is a copy, regenerated on every launch, and never a link. Pi
# writes model and thinking choices into its settings file; through a link those
# writes would reach the original profile. The copy is replaced atomically, so a
# link left by an earlier layout is replaced rather than followed.
refresh_settings() {
	local tmp="$PROFILE_DIR/settings.json.tmp"
	cp "$SOURCE_DIR/settings.json" "$tmp"
	mv -f "$tmp" "$PROFILE_DIR/settings.json"
}

# --- Copilot authentication ---------------------------------------------------
# The check only reports; Pi still starts so that /login is available.
warn_if_not_logged_in() {
	local status
	status="$(PI_OFFLINE=1 pi auth check --provider "$COPILOT_PROVIDER" --json 2>/dev/null || true)"
	if [[ "$status" != *'"status":"ready"'* ]]; then
		printf '%s: GitHub Copilot is not logged in for this profile (%s).\n' "$SCRIPT_NAME" "$PROFILE_DIR" >&2
		printf '%s: inside Pi, run /login and choose GitHub Copilot. The original pi login is not used.\n' "$SCRIPT_NAME" >&2
	fi
}

# --- Argument scoping ---------------------------------------------------------
# `--models` limits the models for a new session; a resumed session keeps its
# own model. Scoping to Copilot here, instead of editing settings.json, keeps
# the original default provider intact. A caller-supplied --models wins.
caller_sets_models() {
	local arg
	for arg in "$@"; do
		case "$arg" in
		--) return 1 ;;
		--models | --models=*) return 0 ;;
		esac
	done
	return 1
}

is_subcommand() {
	local word
	for word in $PI_SUBCOMMANDS; do
		[[ "$1" == "$word" ]] && return 0
	done
	return 1
}

main() {
	command -v pi >/dev/null 2>&1 || die "the pi executable was not found on PATH" 127

	unset COPILOT_GITHUB_TOKEN
	prepare_profile

	export PI_CODING_AGENT_DIR="$PROFILE_DIR"

	# Subcommands such as `update` or `auth check` are dispatched by Pi only when
	# they come first, and they do not start a conversation, so no scope is added.
	if [[ $# -gt 0 ]] && is_subcommand "$1"; then
		exec pi "$@"
	fi

	warn_if_not_logged_in

	if caller_sets_models "$@"; then
		exec pi "$@"
	fi
	exec pi --models "$COPILOT_PROVIDER/*" "$@"
}

main "$@"
